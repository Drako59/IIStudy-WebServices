<Window x:Class="IIStudyDESKTOP.WindowsPages.CreateExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        xmlns:converter="clr-namespace:IIStudyDESKTOP"
        mc:Ignorable="d"
        Title="CreateExamWindow"  Height="560" Width="500">
    <Window.Resources>
        <converter:StringToDateConverter x:Key="StringToDateConverter"></converter:StringToDateConverter>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"></BooleanToVisibilityConverter>
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="42"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>

                            <!-- BOX -->
                            <Border x:Name="Border"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">

                                <!-- 🔥 כל האזור לחיץ -->
                                <ToggleButton
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- TEXT (רק השם) -->
                                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#1e293b"
                            Text="{Binding SelectedItem.Subject_name, RelativeSource={RelativeSource TemplatedParent}}"/>

                                        <!-- ARROW -->
                                        <TextBlock Grid.Column="1"
                                   Text="▼"
                                   FontSize="10"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                            </Border>

                            <!-- DROPDOWN -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False">

                                <Border Margin="0,4,0,0"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#e2e8f0"
                        BorderThickness="1.5">

                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- HOVER / FOCUS -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#a5b4fc"/>
                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <!--<Setter Property="ToolTip"
            Value="{Binding RelativeSource={RelativeSource Self},
            Path=(Validation.Errors)[0].ErrorContent}"/>-->
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--<Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#ef4444"/>
                            </Trigger>-->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1565c0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#90caf9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1565c0" Offset="0"/>
                                    <GradientStop Color="#1976d2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1565c0" Offset="0"/>
                                    <GradientStop Color="#1976d2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#1565c0" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.32"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#f1f5f9" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer shadow -->
    <Border Margin="16" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#1565c0" BlurRadius="40" ShadowDepth="0" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0f4c81" Offset="0"/>
                        <GradientStop Color="#1565c0" Offset="0.5"/>
                        <GradientStop Color="#1976d2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative blobs -->
                    <Ellipse Width="160" Height="160"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-60,-40,0" Opacity="0.10" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="22,18,16,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="13"
                                Background="White"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.16"/>
                            </Border.Effect>
                            <TextBlock Text="✏️" FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Create Exam"
                                       FontSize="18" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="TxtSubtitle"
                                       Text="Create exam"
                                       FontSize="11" Foreground="#bbdefb"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="Close_click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#ffffff22"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕" FontSize="13" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 FORM FIELDS
                 ══════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="26,20,26,10">
                <StackPanel>





                    <!-- Subject Name -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SUBJECT" Style="{StaticResource FieldLabel}"/>
                        <ComboBox
                                Style="{StaticResource ModernComboBox}"
                                x:Name="InputSubjectID"
                                ItemsSource="{Binding Subjects}"
                                DisplayMemberPath="Subject_name"
                                SelectedValuePath="SubjectID"
                                SelectedValue="{Binding SubjectID}" />
                    </StackPanel>

                    <!-- Exam Name -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding (Validation.HasError),ElementName=InputExamName,

         Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" >
                                <Canvas Width="14" Height="14">
                                    <Ellipse Width="13" Height="13" Canvas.Left="0.5" Canvas.Top="0.5"
                      Stroke="#e24b4a" StrokeThickness="1" Fill="Transparent"/>
                                    <Rectangle Width="1.3" Height="3.5" Canvas.Left="6.35" Canvas.Top="3.5"
                         Fill="#e24b4a" RadiusX="0.65" RadiusY="0.65"/>
                                    <Ellipse Width="1.4" Height="1.4" Canvas.Left="6.3" Canvas.Top="9.3"
                      Fill="#e24b4a"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock FontSize="11" x:Name="ErrorExamName"
                 FontWeight="SemiBold"
                 Foreground="#ef4444"
                 Margin="4,4,0,0"
                 Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=InputExamName}"
                 />

                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}">
                            EXAM NAME <Run Foreground="#ef4444">*</Run>
                        </TextBlock>
                        <TextBox x:Name="InputExamName" TextChanged="ValidateFields" Style="{StaticResource InputBox}" Text="{Binding Exam_Name ,UpdateSourceTrigger=PropertyChanged,
                                                                                                            ValidatesOnDataErrors=True,
                                                                                                            ValidatesOnNotifyDataErrors=True,
                                                                                                            NotifyOnValidationError=True}"/>
                    </StackPanel>

                    <!-- Exam Year -->
                    <StackPanel Margin="0,0,0,16">

                        <StackPanel Orientation="Horizontal" Visibility="{Binding (Validation.HasError),ElementName=InputExamYear,

        Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" >
                                <Canvas Width="14" Height="14">
                                    <Ellipse Width="13" Height="13" Canvas.Left="0.5" Canvas.Top="0.5"
                        Stroke="#e24b4a" StrokeThickness="1" Fill="Transparent"/>
                                    <Rectangle Width="1.3" Height="3.5" Canvas.Left="6.35" Canvas.Top="3.5"
                            Fill="#e24b4a" RadiusX="0.65" RadiusY="0.65"/>
                                    <Ellipse Width="1.4" Height="1.4" Canvas.Left="6.3" Canvas.Top="9.3"
                        Fill="#e24b4a"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock FontSize="11" x:Name="ErrorExamYear"
            FontWeight="SemiBold"
            Foreground="#ef4444"
            Margin="4,4,0,0"
            Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=InputExamYear}"
            />

                        </StackPanel>
                        <!--<TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ElementName=InputExamYear, Path=(Validation.HasError)}"
                                                     Value="True">

                                            <Setter Property="Visibility" Value="Visible"/>

                                            <Setter Property="Text"
                                                    Value="{Binding ElementName=InputExamYear,
                                                                    Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>

                            </TextBlock.Style>-->
                        <!--</TextBlock>-->

                        <TextBlock Style="{StaticResource FieldLabel}">
                            EXAM YEAR <Run Foreground="#ef4444">*</Run>
                        </TextBlock>
                        <DatePicker x:Name="InputExamYear"
                                    SelectedDate="{Binding Exam_Year,
                                                           Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged,Converter={StaticResource StringToDateConverter},
                                                           ValidatesOnDataErrors=True,
                                                           ValidatesOnNotifyDataErrors=True,
                                                           NotifyOnValidationError=True}"
                                     SelectedDateFormat="Short"
                                    Language="en-CA"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#1e293b"
                                    Background="White"
                                    BorderBrush="#e2e8f0"
                                    BorderThickness="1.5"
                                    Height="40"
                                    Padding="8,4"/>
                    </StackPanel>

                    <!-- PDF File -->
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding (Validation.HasError),ElementName=TxtSelectedFile,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" >
                                <Canvas Width="14" Height="14">
                                    <Ellipse Width="13" Height="13" Canvas.Left="0.5" Canvas.Top="0.5"
                                    Stroke="#e24b4a" StrokeThickness="1" Fill="Transparent"/>
                                    <Rectangle Width="1.3" Height="3.5" Canvas.Left="6.35" Canvas.Top="3.5"
                                        Fill="#e24b4a" RadiusX="0.65" RadiusY="0.65"/>
                                    <Ellipse Width="1.4" Height="1.4" Canvas.Left="6.3" Canvas.Top="9.3"
                                    Fill="#e24b4a"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock FontSize="11" x:Name="ErrorExamFile"
                             FontWeight="SemiBold"
                            Foreground="#ef4444"
                            Margin="4,4,0,0"
                            Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=TxtSelectedFile}"
                             />

                        </StackPanel>
                        <TextBlock Text="PDF FILE" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#f0f4ff" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <!-- Current file row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📄 " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCurrentFile"
                                               Text="{Binding File_path_url,UpdateSourceTrigger=PropertyChanged}"
                                               FontSize="11" Foreground="#1565c0"
                                               TextDecorations="Underline"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="320"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Browse row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="4*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Path display box -->
                                    <Border Grid.Column="0"
                                            Background="White"
                                            BorderBrush="#c7d2fe"
                                            BorderThickness="1.5"
                                            CornerRadius="9"
                                            Padding="10,0"
                                            Height="38" Grid.ColumnSpan="2" Margin="0,1,0,1">
                                        <TextBlock x:Name="TxtSelectedFile"
                                                   Text="{Binding File_path_url,UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="11"
                                                   Foreground="#94a3b8"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- Browse button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BrowseBtn}"
                                            Click="BrowsePdf_Click" Grid.ColumnSpan="2" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="12,0">
                                            <TextBlock Text="📂 " FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Browse" FontSize="12" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                 FOOTER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="26,10,26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource CancelBtn}"
                            Click="Close_click">
                        <TextBlock Text="← Cancel"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#64748b"/>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource SaveBtn}"
                            Click="CreateExam"
                            >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Exam"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
