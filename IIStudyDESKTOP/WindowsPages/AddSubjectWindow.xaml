<Window x:Class="IIStudyDESKTOP.WindowsPages.AddSubjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        mc:Ignorable="d"
        Title="AddSubjectWindow" Height="340" Width="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"></BooleanToVisibilityConverter>

    </Window.Resources>
    <Border Margin="16" CornerRadius="20" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#1565c0" BlurRadius="36" ShadowDepth="0" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════
                 HEADER
                 ══════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="20,20,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0f4c81" Offset="0"/>
                        <GradientStop Color="#1565c0" Offset="0.5"/>
                        <GradientStop Color="#1976d2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative blob -->
                    <Ellipse Width="140" Height="140"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-50,-30,0" Opacity="0.10" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="20,16,14,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="44" Height="44"
                                CornerRadius="12"
                                Background="White"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10"
                                                  ShadowDepth="0" Opacity="0.14"/>
                            </Border.Effect>
                            <TextBlock Text="🏷" FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="New Subject"
                                       FontSize="17" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <TextBlock Text="Add a subject to the system"
                                       FontSize="11" Foreground="#bbdefb"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="2"
                                Width="28" Height="28"
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#ffffff22"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕" FontSize="12" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════
                 FORM
                 ══════════════════════════════ -->

            
                <StackPanel Grid.Row="1" Margin="24,20,24,10">
                <StackPanel Orientation="Horizontal" Visibility="{Binding (Validation.HasError),ElementName=InputSubjectTxt,
                                         Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" >
                        <Canvas Width="14" Height="14">
                            <Ellipse Width="13" Height="13" Canvas.Left="0.5" Canvas.Top="0.5"
                                    Stroke="#e24b4a" StrokeThickness="1" Fill="Transparent"/>
                            <Rectangle Width="1.3" Height="3.5" Canvas.Left="6.35" Canvas.Top="3.5"
                                        Fill="#e24b4a" RadiusX="0.65" RadiusY="0.65"/>
                            <Ellipse Width="1.4" Height="1.4" Canvas.Left="6.3" Canvas.Top="9.3"
                                    Fill="#e24b4a"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock FontSize="11" 
                             FontWeight="SemiBold"
                            Foreground="#ef4444"
                            Margin="4,4,0,0"
                            Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=InputSubjectTxt}"
/>

                </StackPanel>
                <TextBlock x:Name="InputSubjectName"
                           Text="SUBJECT NAME"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#64748b"
                           Margin="0,0,0,6"/>

                <!-- Input box -->
                <Border Background="White"
                        BorderBrush="#e2e8f0"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="0"
                        x:Name="InputBorder">
                    <TextBox x:Name="InputSubjectTxt"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13" FontWeight="SemiBold"
                             Foreground="#1e293b"
                             Padding="12,10"
                             Height="42"
                             Text="{Binding Subject_name, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             
                             />
                </Border>

                <!-- Error message -->
                <TextBlock x:Name="ErrorMsg"
                           Text=""
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#ef4444"
                           Margin="4,6,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>

            <!-- ══════════════════════════════
                 FOOTER BUTTONS
                 ══════════════════════════════ -->
            <Border Grid.Row="2" Padding="24,8,24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel -->
                    <Button Grid.Column="0" Height="42" BorderThickness="0"
                            Cursor="Hand" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#f1f5f9" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Cancel" FontSize="13" FontWeight="Bold"
                                   Foreground="#64748b"/>
                    </Button>

                    <!-- Add Subject -->
                    <Button Grid.Column="2" Height="42" BorderThickness="0"
                            Cursor="Hand" Click="AddSubject">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1565c0" Offset="0"/>
                                            <GradientStop Color="#1976d2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1565c0" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.87"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="17" FontWeight="ExtraBold"
                                       Foreground="White" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Add Subject" FontSize="13" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
