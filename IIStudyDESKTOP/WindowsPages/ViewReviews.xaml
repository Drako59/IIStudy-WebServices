<Window x:Class="IIStudyDESKTOP.WindowsPages.ViewReviews"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        mc:Ignorable="d"
        xmlns:convertor="clr-namespace:IIStudyDESKTOP"
        Title="ViewReviews" Height="680" Width="560">
    <Window.Resources>

        <!-- Star rating converter is handled in code-behind via binding -->
        <convertor:UrlConverter x:Key="UrlConverter">

        </convertor:UrlConverter>
        <convertor:InitialsConvertor x:Key="InitialsConvertor"></convertor:InitialsConvertor>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#fee2e2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer glow shadow -->
    <Border Margin="18" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#764ba2" BlurRadius="40" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Summary bar -->
                <RowDefinition Height="*"/>
                <!-- Review list -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════
                 HEADER
                 ══════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True" Padding="24,20,20,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!-- Wrap both the decorative ellipse and the content grid inside one Grid -->
                <Grid>
                    <!-- Decorative circle -->
                    <Ellipse Width="160" Height="160"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-60,-40,0" Opacity="0.10"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Content -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="⭐ Reviews"
                                       FontSize="22" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="TxtBookTitle"
                                       Text="Book Title"
                                       FontSize="13" Foreground="#ddd6fe"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"/>
                        </StackPanel>

                        <!-- Close button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource CloseBtn}"
                                VerticalAlignment="Top"
                                Click="Close_Click">
                            <TextBlock Text="✕" FontSize="14" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════
                 SUMMARY BAR
                 ══════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="#f8fafc"
                    BorderBrush="#f1f5f9"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total reviews -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTotalReviews" Text="0"
                                   FontSize="22" FontWeight="ExtraBold"
                                   Foreground="#1e293b"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Reviews"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Avg rating -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtAvgRating" Text="0.0"
                                   FontSize="22" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Avg Rating"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Total likes -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTotalLikes" Text="0"
                                   FontSize="22" FontWeight="ExtraBold"
                                   Foreground="#22c55e"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="👍 Likes"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Total dislikes -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTotalDislikes" Text="0"
                                   FontSize="22" FontWeight="ExtraBold"
                                   Foreground="#ef4444"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="👎 Dislikes"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════
                 REVIEWS LIST
                 ══════════════════════════════ -->
            <Grid Grid.Row="2">

                <!-- Actual list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="20,14,20,16">
                    <ItemsControl x:Name="ReviewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- ═══════════════════════════════════
                                     REVIEW CARD
                                     ═══════════════════════════════════ -->
                                <Border Margin="0,0,0,14"
                                        CornerRadius="18"
                                        Background="White"
                                        BorderBrush="#ede9fe"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#667eea" BlurRadius="18"
                                                          ShadowDepth="0" Opacity="0.07"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Header: avatar + name + stars -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Comment body -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Footer: likes + delete -->
                                        </Grid.RowDefinitions>

                                        <!-- ── HEADER ───────────────────── -->
                                        <Border Grid.Row="0"
                                                CornerRadius="18,18,0,0"
                                                Padding="16,14,16,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#faf9ff" Offset="0"/>
                                                    <GradientStop Color="#f3f0ff" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar -->
                                                <Border Grid.Column="0"
                                                        Width="44" Height="44"
                                                        CornerRadius="22"
                                                        Margin="0,0,12,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#667eea" Offset="0"/>
                                                            <GradientStop Color="#764ba2" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#764ba2"
                                                                          BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.40"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <TextBlock Text="{Binding UserName,Converter= {StaticResource InitialsConvertor}}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding RegisteredID,
                                                                            Converter={StaticResource UrlConverter},
                                                                            ConverterParameter=Registered}"
                                                                            Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                </Border>

                                                <!-- Name + ID -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="#1e293b"/>
                                                    <TextBlock Text="{Binding ReviewID}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#a78bfa"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Stars badge (top right) -->
                                                <Border Grid.Column="2"
                                                        CornerRadius="12"
                                                        Padding="10,5"
                                                        Background="{Binding RatingBackground}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StarsText}"
                                                                   FontSize="12" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Rate}"
                                                                   FontSize="13" FontWeight="ExtraBold"
                                                                   Foreground="{Binding RatingColor}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- ── COMMENT BODY ──────────────── -->
                                        <Border Grid.Row="1" Padding="16,12,16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left accent bar -->
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        CornerRadius="4"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Stretch">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#667eea" Offset="0"/>
                                                            <GradientStop Color="#764ba2" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Comment text -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Comment}"
                                                           FontSize="13"
                                                           Foreground="#374151"
                                                           TextWrapping="Wrap"
                                                           LineHeight="22"
                                                           FontStyle="Italic"/>
                                            </Grid>
                                        </Border>

                                        <!-- ── FOOTER ───────────────────── -->
                                        <Border Grid.Row="2"
                                                CornerRadius="0,0,18,18"
                                                Padding="14,8,14,10"
                                                Background="#fafafa"
                                                BorderBrush="#f1f5f9"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Review image (optional) -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Spacer -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Likes + Dislikes + Delete -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Review image thumbnail -->
                                                <Border Grid.Column="0"
                                                        Width="36" Height="36"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding ImageVisibility}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="6"
                                                                          ShadowDepth="0" Opacity="0.12"/>
                                                    </Border.Effect>
                                                    <Image Source="{Binding ReviewImageSource}"
                                                           Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- Right side: likes / dislikes / delete -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                    <!-- 👍 Likes -->
                                                    <Border CornerRadius="10"
                                                            Padding="10,5"
                                                            Background="#f0fdf4"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👍" FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding Likes}"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       Foreground="#16a34a"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 👎 Dislikes -->
                                                    <Border CornerRadius="10"
                                                            Padding="10,5"
                                                            Background="#fef2f2"
                                                            Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👎" FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding Dislikes}"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       Foreground="#dc2626"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 🗑 Delete button -->
                                                    <!--Click="DeleteReview_Click"-->
                                                    <Button Tag="{Binding}"
                                                            Click="RemoveReview"
                                                            Cursor="Hand"
                                                            BorderThickness="0"
                                                            ToolTip="Delete review">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="delBorder"
                                                                        Background="#fef2f2"
                                                                        CornerRadius="10"
                                                                        Padding="10,5">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="🗑"
                                                                                   FontSize="13"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,5,0"/>
                                                                        <TextBlock Text="Delete"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#ef4444"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="delBorder"
                                                                                Property="Background"
                                                                                Value="#fee2e2"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="delBorder"
                                                                                Property="Background"
                                                                                Value="#fecaca"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="No reviews yet"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="This book hasn't been reviewed yet."
                                   FontSize="12" Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
