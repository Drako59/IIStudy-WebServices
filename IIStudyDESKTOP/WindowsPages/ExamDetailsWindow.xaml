<Window x:Class="IIStudyDESKTOP.WindowsPages.ExamDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        
        mc:Ignorable="d"
        Title="ExamDetailsWindow" Height="620" Width="500">
    <!--WindowStyle="None"-->

    <Window.Resources>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>

        <Style x:Key="EditBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#c7d2fe"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1565c0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer glow shadow -->
    <Border Margin="16" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#1565c0" BlurRadius="40" ShadowDepth="0" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Hero -->
                <RowDefinition Height="*"/>
                <!-- Details -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════
                 HERO BANNER
                 ════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0f4c81" Offset="0"/>
                        <GradientStop Color="#1565c0" Offset="0.5"/>
                        <GradientStop Color="#1976d2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative blobs -->
                    <Ellipse Width="190" Height="190"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-70,-45,0" Opacity="0.10" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="110" Height="110"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-25,0,0,10" Opacity="0.08" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Top-right controls: Edit toggle + Close -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,12,12,0">

                        <!-- Edit / Cancel toggle -->
                        <Button x:Name="BtnEditToggle"
                                BorderThickness="0" Cursor="Hand"
                                Padding="12,6"
                                Click="ViewEditExamWindow"
                                >
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="EditIcon" Text="✏️"
                                                       FontSize="13" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="EditLabel" Text="Edit"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#f1f5f9"/>
                                            <Setter TargetName="EditLabel" Property="Foreground" Value="#64748b"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close -->
                        <Button Width="30" Height="30" BorderThickness="0" Cursor="Hand"
                                Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#f1f5f9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="CloseText" Text="✕" FontSize="13" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>

                    <!-- Hero content: icon + name + year -->
                    <Grid Margin="22,22,22,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Exam icon card -->
                        <Border Grid.Column="0"
                                Width="68" Height="68"
                                CornerRadius="16"
                                Background="White"
                                Margin="0,0,18,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="14"
                                                  ShadowDepth="0" Opacity="0.18"/>
                            </Border.Effect>
                            <TextBlock Text="📝" FontSize="34"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name + year + access badge -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Access badge -->
                            <!--<Border x:Name="AccessBadge"
                                    CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"
                                    Background="white">
                                <TextBlock x:Name="TxtAccessBadge"
                                           Text="🔓 Open Access"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>-->

                            <TextBlock x:Name="TxtExamName"
                                       Text="{Binding Exam_Name}"
                                       FontSize="18" FontWeight="ExtraBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"
                                       MaxWidth="270"/>
                            <TextBlock x:Name="TxtExamYear"
                                       FontSize="12" Foreground="#bbdefb"
                                       Margin="0,5,0,0">
                                <Run Text="📅  Year: "/>
                                <Run x:Name="RunYear" Text="{Binding Exam_Year}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════
                 DETAILS / EDIT BODY
                 ════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,18,22,10">
                <StackPanel>

                    <!-- ── Row 1: Exam ID + Subject ID ── -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Exam ID — always read-only -->
                        <Border Grid.Column="0" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="EXAM ID" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔖 " FontSize="14"/>
                                    <TextBlock x:Name="TxtExamID" Text="{Binding ExamID}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Subject ID -->
                        <Border Grid.Column="2" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="SUBJECT" Style="{StaticResource InfoLabel}"/>
                                <!-- View mode -->
                                <StackPanel x:Name="ViewSubjectID" Orientation="Horizontal">
                                    <TextBlock Text="🏷 " FontSize="14"/>
                                    <TextBlock x:Name="TxtSubjectID" Text="{Binding Subject_name}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                                <!-- Edit mode -->
                                <TextBox x:Name="EditSubjectID"
                                         Style="{StaticResource EditBox}"
                                         Visibility="Collapsed" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Row 2: Exam Name (full width) ── -->
                    <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="EXAM NAME" Style="{StaticResource InfoLabel}"/>
                            <!-- View mode -->
                            <StackPanel x:Name="ViewExamName" Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="14"/>
                                <TextBlock x:Name="TxtExamNameCard" Text="{Binding Exam_Name}"
                                           Style="{StaticResource InfoValue}"
                                           TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>
                            <!-- Edit mode -->
                            <TextBox x:Name="EditExamName"
                                     Style="{StaticResource EditBox}"
                                     Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Row 3: Year + Access ── -->
                    <!--<Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>-->

                    <!-- Year -->
                    <Border Grid.Column="0" CornerRadius="12" Padding="14,11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#e3f2fd" Offset="0"/>
                                <GradientStop Color="#bbdefb" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="EXAM YEAR" Style="{StaticResource InfoLabel}"/>
                            <!-- View mode -->
                            <StackPanel x:Name="ViewExamYear" Orientation="Horizontal">
                                <TextBlock Text="📅 " FontSize="14"/>
                                <TextBlock x:Name="TxtExamYearCard" Text="{Binding Exam_Year}"
                                               FontSize="18" FontWeight="ExtraBold"
                                               Foreground="#1565c0"/>
                            </StackPanel>
                            <!-- Edit mode -->
                            <TextBox x:Name="EditExamYear"
                                         Style="{StaticResource EditBox}"
                                         Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Access -->
                    <!--<Border Grid.Column="2" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ACCESS" Style="{StaticResource InfoLabel}"/>
                                -->
                    <!-- View mode -->
                    <!--
                                <Border x:Name="AccessViewBadge"
                                        CornerRadius="8" Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtAccessCard"
                                               FontSize="12" FontWeight="Bold"/>
                                </Border>
                                -->
                    <!-- Edit mode -->
                    <!--
                                <CheckBox x:Name="EditAccess"
                                          Content="Open Access"
                                          FontSize="13" FontWeight="SemiBold"
                                          Foreground="#1e293b"
                                          Visibility="Collapsed"
                                          Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>-->
                    <!--</Grid>-->

                    <!-- ── File URL (full width) ── -->
                    <Border Style="{StaticResource InfoCard}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="FILE PATH / URL" Style="{StaticResource InfoLabel}"/>
                            <!-- View mode -->
                            <StackPanel x:Name="ViewFileUrl" Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="14"/>
                                <TextBlock x:Name="TxtFileUrl"
                                           Text="{Binding File_path_url}"
                                           FontSize="12" Foreground="#1565c0"
                                           TextWrapping="Wrap"
                                           TextDecorations="Underline"
                                           Cursor="Hand"
                                           MaxWidth="360"/>
                            </StackPanel>
                            <!-- Edit mode -->
                            <TextBox x:Name="EditFileUrl"
                                     Style="{StaticResource EditBox}"
                                     Visibility="Collapsed" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════
                 FOOTER BUTTONS
                 ════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="22,10,22,20">
                <!--<Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>-->

                    <!-- Close / Cancel -->
                    <Button Grid.Column="0" Height="44" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="#f1f5f9" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="TxtCloseLabel"
                                   Text="Close" FontSize="14" FontWeight="Bold"
                                   Foreground="#64748b"/>
                    </Button>

                    <!-- Save (hidden until edit mode) -->
                    <!--<Button Grid.Column="2"
                            x:Name="BtnSave"
                            Height="44" BorderThickness="0" Cursor="Hand"
                            Visibility="Collapsed"
                            >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1565c0" Offset="0"/>
                                            <GradientStop Color="#1976d2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1565c0" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Changes" FontSize="14" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>-->

                <!--</Grid>-->
            </Border>

        </Grid>
    </Border>
</Window>
