<Window x:Class="IIStudyDESKTOP.WindowsPages.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        mc:Ignorable="d"
        Title="SubjectsWindow" Height="660" Width="520">
    <Window.Resources>
        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow -->
    <Border Margin="16" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#1565c0" BlurRadius="40" ShadowDepth="0" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Add bar -->
                <RowDefinition Height="*"/>
                <!-- List -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0f4c81" Offset="0"/>
                        <GradientStop Color="#1565c0" Offset="0.5"/>
                        <GradientStop Color="#1976d2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative blobs -->
                    <Ellipse Width="170" Height="170"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-65,-40,0" Opacity="0.10" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="100" Height="100"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-25,0,0,0" Opacity="0.08" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="22,18,16,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="50" Height="50"
                                CornerRadius="13"
                                Background="White"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.14"/>
                            </Border.Effect>
                            <TextBlock Text="🏷" FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + count badge -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SUBJECTS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#bbdefb" Margin="0,0,0,4"/>
                            <TextBlock Text="All Subjects"
                                       FontSize="18" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border Background="White" CornerRadius="8" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏷 " FontSize="12"/>
                                        <TextBlock x:Name="TxtSubjectCount"
                                                   Text="0 subjects"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#1565c0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#ffffff22"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕" FontSize="13" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ADD SUBJECT BAR
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="#f0f4ff"
                    BorderBrush="#c7d2fe"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search box -->
                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="#e2e8f0"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Height="40">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="12" Foreground="#1e293b"
                                     Padding="32,0,10,0"
                                     VerticalContentAlignment="Center"
                                     />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search subjects..."
                                       FontSize="12" Foreground="#cbd5e1"
                                       VerticalAlignment="Center"
                                       Margin="32,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- + Add Subject button -->
                    <Button Grid.Column="2"
                            Height="40" BorderThickness="0"
                            Cursor="Hand" 
                            Click="AddSubject">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1565c0" Offset="0"/>
                                            <GradientStop Color="#1976d2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1565c0" BlurRadius="12"
                                                          ShadowDepth="0" Opacity="0.26"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Margin="14,0">
                                        <TextBlock Text="+" FontSize="18" FontWeight="ExtraBold"
                                                   Foreground="White" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Add Subject"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.70"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 SUBJECTS LIST
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="2">

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12,18,12">
                    <ItemsControl x:Name="SubjectsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        CornerRadius="14"
                                        Background="White"
                                        BorderBrush="#bbdefb"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1565c0" BlurRadius="12"
                                                          ShadowDepth="0" Opacity="0.05"/>
                                    </Border.Effect>

                                    <Grid Margin="14,12,14,12">
                                        <Grid.ColumnDefinitions>
                                            <!-- ID pill -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Icon -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Name -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Exam count badge -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Delete button -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ID pill -->
                                        <Border Grid.Column="0"
                                                Background="#e3f2fd"
                                                CornerRadius="7" Padding="8,4"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SubjectID}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="#1565c0"/>
                                        </Border>

                                        <!-- Tag icon -->
                                        <Border Grid.Column="1"
                                                Width="36" Height="36"
                                                CornerRadius="10"
                                                Background="#e3f2fd"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="🏷" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Subject name -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Subject_name}"
                                                   FontSize="14" FontWeight="ExtraBold"
                                                   Foreground="#0f172a"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Edit button -->
                                        <Button Grid.Column="4"
                                                Style="{StaticResource CardBtn}"
                                                Background="#e3f2fd"
                                                Tag="{Binding}"
                                                >
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✏️ " FontSize="12"/>
                                                <TextBlock Text="Edit"
                   FontSize="11" FontWeight="Bold"
                   Foreground="#1565c0"
                   VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="🏷" FontSize="46"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No subjects yet"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="Click + Add Subject to create the first one."
                                   FontSize="12" Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ══════════════════════════════════════════
                 FOOTER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="3" Padding="18,10,18,18">
                <Button Height="44" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#f1f5f9" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Close" FontSize="14" FontWeight="Bold"
                               Foreground="#64748b"/>
                </Button>
            </Border>

        </Grid>
    </Border>
</Window>
