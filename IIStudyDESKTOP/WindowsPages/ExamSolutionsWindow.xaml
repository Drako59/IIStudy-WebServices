<Window x:Class="IIStudyDESKTOP.WindowsPages.ExamSolutionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        xmlns:converter="clr-namespace:IIStudyDESKTOP"
        mc:Ignorable="d"
        Title="ExamSolutionsWindow" Height="680" Width="560">
    <Window.Resources>
        <converter:HasFileToBoolConverter x:Key="HasFileToBool"></converter:HasFileToBoolConverter>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
        </Style>

        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer glow -->
    <Border Margin="16" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#1565c0" BlurRadius="40" ShadowDepth="0" Opacity="0.16"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Add solution bar -->
                <RowDefinition Height="*"/>
                <!-- Solutions list -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0f4c81" Offset="0"/>
                        <GradientStop Color="#1565c0" Offset="0.5"/>
                        <GradientStop Color="#1976d2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative blobs -->
                    <Ellipse Width="170" Height="170"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-65,-40,0" Opacity="0.10" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="100" Height="100"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-25,0,0,0" Opacity="0.08" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="22,18,16,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                                Width="50" Height="50"
                                CornerRadius="13"
                                Background="White"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.14"/>
                            </Border.Effect>
                            <TextBlock Text="💡" FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Titles -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SOLUTIONS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#bbdefb" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtExamTitle"
                                       Text="Exam Solutions"
                                       FontSize="18" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <!-- Count badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border Background="White" CornerRadius="8" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💡 " FontSize="12"/>
                                        <TextBlock x:Name="TxtSolutionCount"
                                                   Text="0"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#1565c0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text=" solutions" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1565c0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#ffffff22"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕" FontSize="13" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 ADD NEW SOLUTION BAR
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="#f0f4ff"
                    BorderBrush="#c7d2fe"
                    BorderThickness="0,0,0,1"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Info text -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Add New Solution"
                                   FontSize="13" FontWeight="ExtraBold"
                                   Foreground="#1565c0"/>
                        <TextBlock Text="Upload a new solution file for this exam"
                                   FontSize="11" Foreground="#64748b"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Add button -->
                    <Button Grid.Column="2" Click="CreateSolution"
                            Height="40" BorderThickness="0" Cursor="Hand"
                            >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="11">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1565c0" Offset="0"/>
                                            <GradientStop Color="#1976d2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1565c0" BlurRadius="12"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" Margin="16,0">
                                        <TextBlock Text="+" FontSize="18" FontWeight="ExtraBold"
                                                   Foreground="White" VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock Text="Add Solution"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 SOLUTIONS LIST
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="2">

                <!-- List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12,18,12">
                    <ItemsControl x:Name="SolutionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <!-- ── SOLUTION CARD ── -->
                                <Border Margin="0,0,0,10"
                                        CornerRadius="16"
                                        Background="White"
                                        BorderBrush="#bbdefb"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1565c0" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.06"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Top: icon + name + year -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Middle: IDs + file -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Bottom: actions -->
                                        </Grid.RowDefinitions>

                                        <!-- ── TOP ── -->
                                        <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="14,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#e3f2fd" Offset="0"/>
                                                    <GradientStop Color="#f0f9ff" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Border Grid.Column="0"
                                                        Width="42" Height="42"
                                                        CornerRadius="11"
                                                        Background="#1565c0"
                                                        Margin="0,0,12,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#1565c0" BlurRadius="10"
                                                                          ShadowDepth="0" Opacity="0.35"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="💡" FontSize="20"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Name + year -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Solution ID pill -->
                                                    <Border CornerRadius="5" Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,0,0,4"
                                                            Background="#e3f2fd">
                                                        <TextBlock Text="{Binding SolutionID}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="#1565c0"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Solution_Name}"
                                                               FontSize="14" FontWeight="ExtraBold"
                                                               Foreground="#0f172a"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="270"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="📅 " FontSize="11"/>
                                                        <TextBlock Text="{Binding Solution_Year}"
                                                                   FontSize="11" Foreground="#64748b"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- File indicator (top-right) -->
                                                <Border Grid.Column="2"
                                                        CornerRadius="8" Padding="8,4"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#fef2f2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding File_path_url, Converter={StaticResource HasFileToBool}}" Value="True">
                                                                    <Setter Property="Background" Value="#f0fdf4"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✕ No File"/>
                                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding File_path_url, Converter={StaticResource HasFileToBool}}" Value="True">
                                                                        <Setter Property="Text" Value="📄 PDF"/>
                                                                        <Setter Property="Foreground" Value="#16a34a"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- ── MIDDLE: IDs + file path ── -->
                                        <Border Grid.Row="1" Padding="14,8,14,8"
                                                BorderBrush="#f1f5f9" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Subject Name -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="SUBJECT NAME" Style="{StaticResource MetaLabel}"/>
                                                    <TextBlock Text="{Binding DataContext.Subject_name, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Style="{StaticResource MetaValue}"/>
                                                </StackPanel>

                                                <!-- Divider -->
                                                <Border Grid.Column="1" Width="1"
                                                        Background="#e2e8f0"
                                                        VerticalAlignment="Stretch"/>

                                                <!-- Exam ID -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="EXAM ID" Style="{StaticResource MetaLabel}"/>
                                                    <TextBlock Text="{Binding ExamID}"
                                                               Style="{StaticResource MetaValue}"/>
                                                </StackPanel>

                                                <!-- Divider -->
                                                <Border Grid.Column="3" Width="1"
                                                        Background="#e2e8f0"
                                                        VerticalAlignment="Stretch"/>

                                                <!-- File path (truncated) -->
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="FILE" Style="{StaticResource MetaLabel}"/>
                                                    <TextBlock Text="{Binding File_path_url}"
                                                               FontSize="11" Foreground="#1565c0"
                                                               TextDecorations="Underline"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand"
                                                               MaxWidth="130"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- ── BOTTOM: action buttons ── -->
                                        <Border Grid.Row="2"
                                                CornerRadius="0,0,16,16"
                                                Padding="14,8,14,10"
                                                Background="#fafafa"
                                                BorderBrush="#f1f5f9"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right">

                                                <!-- Edit Solution -->
                                                <Button Style="{StaticResource CardBtn}"
                                                        Background="#e3f2fd"
                                                        Margin="0,0,8,0"
                                                        Tag="{Binding}"
                                                        Click="EditSolution"
                                                        >
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✏️ " FontSize="12"/>
                                                        <TextBlock Text="Edit Solution"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="#1565c0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Remove -->
                                                <Button Style="{StaticResource CardBtn}"
                                                        Background="#fef2f2"
                                                        Tag="{Binding}"
                                                        >
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗑 " FontSize="12"/>
                                                        <TextBlock Text="Remove"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="#dc2626"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20">
                        <TextBlock Text="💡" FontSize="46" HorizontalAlignment="Center"/>
                        <TextBlock Text="No solutions yet"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="Click + Add Solution to upload the first one."
                                   FontSize="12" Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════
                 FOOTER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="3" Padding="18,10,18,18">
                <Button Height="44" BorderThickness="0" Cursor="Hand"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#f1f5f9" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Close" FontSize="14" FontWeight="Bold" Foreground="#64748b"/>
                </Button>
            </Border>

        </Grid>
    </Border>
</Window>
