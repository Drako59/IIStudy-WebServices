<Window x:Class="IIStudyDESKTOP.WindowsPages.CreateBookPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        mc:Ignorable="d"
        Title="CreateBookPage" Height="540" Width="700">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>


        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="42"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>

                            <!-- BOX -->
                            <Border x:Name="Border"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                                <!-- 🔥 כל האזור לחיץ -->
                                <ToggleButton
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- TEXT (רק השם) -->
                                        <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#1e293b"
                                    Text="{Binding SelectedItem.Value, RelativeSource={RelativeSource TemplatedParent}}"/>

                                        <!-- ARROW -->
                                        <TextBlock Grid.Column="1"
                                           Text="▼"
                                           FontSize="10"
                                           Foreground="#64748b"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                            </Border>

                            <!-- DROPDOWN -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False">

                                <Border Margin="0,4,0,0"
                                Background="White"
                                CornerRadius="10"
                                BorderBrush="#e2e8f0"
                                BorderThickness="1.5">

                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- HOVER / FOCUS -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#a5b4fc"/>
                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#a5b4fc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UploadBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreateBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#667eea" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow -->
    <Border Margin="18" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#764ba2" BlurRadius="40" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Hero header -->
                <RowDefinition Height="*"/>
                <!-- Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 HERO — gradient bar with cover + browse
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative circles -->
                    <Ellipse Width="200" Height="200"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-80,-50,0" Opacity="0.09" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="120" Height="120"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-30,0,0,10" Opacity="0.08" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="26,20,26,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Book cover preview -->
                        <Grid Grid.Column="0" Width="100" VerticalAlignment="Center">
                            <Border Width="100" Height="138" CornerRadius="12" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.28"/>
                                </Border.Effect>
                                <Grid ClipToBounds="True">
                                    <!-- Placeholder gradient -->
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#eef2ff" Offset="0"/>
                                                <GradientStop Color="#f5f3ff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Placeholder icon -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="CoverEmoji" Text="📚" FontSize="36"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Cover" FontSize="10" FontWeight="Bold"
                                                   Foreground="#a5b4fc"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- Actual image -->
                                    <Border CornerRadius="12" ClipToBounds="True">
                                        <Image x:Name="CoverImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                    </Border>
                                    <!-- Hover overlay -->
                                    <Border x:Name="CoverOverlay"
                                            CornerRadius="12"
                                            Background="#80000000"
                                            Visibility="Collapsed"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="CoverOverlay_Click">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🖼" FontSize="22" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Upload" FontSize="11" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Invisible hover catcher -->
                            <Border Width="100" Height="138" CornerRadius="12"
                                    Background="Transparent" Cursor="Hand"
                                    MouseEnter="Cover_MouseEnter"
                                    MouseLeave="Cover_MouseLeave"
                                    MouseLeftButtonUp="CoverOverlay_Click"/>
                        </Grid>

                        <!-- Right: title + image browse -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- Icon badge -->
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8">
                                <TextBlock Text="✨" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="New Book"
                                       FontSize="20" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <TextBlock Text="Fill in the details to add a book"
                                       FontSize="12" Foreground="#ddd6fe"
                                       Margin="0,4,0,16"/>

                            <!-- Cover image browse row -->
                            <TextBlock Text="COVER IMAGE" Style="{StaticResource FieldLabel}"
                                       Foreground="#c4b5fd" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="White"
                                        BorderBrush="White"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,0"
                                        Height="36">
                                    <TextBlock x:Name="TxtImagePath"
                                               Text="No image selected"
                                               FontSize="11"
                                               Foreground="#ddd6fe"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <Button Grid.Column="2"
                                        Style="{StaticResource UploadBtn}"
                                        Background="White"
                                        BorderBrush="Transparent"
                                        Foreground="#667eea"
                                        Click="BrowseImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼 " FontSize="12"/>
                                        <TextBlock Text="Browse" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Close button -->
                        <Button Grid.Column="3"
                                Width="32" Height="32"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="BtnCancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#ffffff22"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕" FontSize="14" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════
                 FORM FIELDS
                 ══════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,18,28,10">
                <StackPanel>

                    <!-- Book Name + Author Name -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                BOOK NAME <Run Foreground="#ef4444">*</Run>
                            </TextBlock>
                            <TextBox x:Name="InputBookName" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                AUTHOR NAME <Run Foreground="#ef4444">*</Run>
                            </TextBlock>
                            <TextBox x:Name="InputAuthorName" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Price + Subject ID -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                PRICE (₪) <Run Foreground="#ef4444">*</Run>
                            </TextBlock>
                            <TextBox x:Name="InputPrice" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SUBJECT ID" Style="{StaticResource FieldLabel}"/>
                            <ComboBox
                                    Style="{StaticResource ModernComboBox}"
                                    x:Name="InputSubjectID"
                                    ItemsSource="{Binding Subjects}"
                                    DisplayMemberPath="Value"
                                    SelectedValuePath="Key"
                                    SelectedValue="{Binding SubjectID}" />
                        </StackPanel>
                    </Grid>

                    <!-- Type + BookAuthor -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Is Online Book" Style="{StaticResource FieldLabel}"/>
                            <CheckBox x:Name="InputType" >
                                <TextBlock Text="✅  Mark as Is online" FontSize="13" FontWeight="SemiBold"/>
                            </CheckBox>
                        </StackPanel>
                        <!--<StackPanel Grid.Column="2">
                            <TextBlock Text="BOOK AUTHOR" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="InputBookAuthor" Style="{StaticResource InputBox}"/>
                        </StackPanel>-->
                    </Grid>

                    <!-- In Stock -->
                    <Border Background="#f8fafc" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <CheckBox x:Name="InputInStock"
                                  IsChecked="True"
                                  FontSize="13" FontWeight="SemiBold" Foreground="#1e293b">
                            <TextBlock Text="✅  Mark as In Stock" FontSize="13" FontWeight="SemiBold"/>
                        </CheckBox>
                    </Border>

                    <!-- PDF Upload -->
                    <TextBlock Text="PDF FILE" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Border Background="#f8fafc" CornerRadius="12" Padding="14,12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#e2e8f0"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="10,0"
                                    Height="38">
                                <TextBlock x:Name="TxtPdfPath"
                                           Text="No PDF selected"
                                           FontSize="12"
                                           Foreground="#94a3b8"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Grid.Column="2"
                                    Style="{StaticResource UploadBtn}"
                                    Background="White"
                                    BorderBrush="#c7d2fe"
                                    Foreground="#667eea"
                                    Click="BrowsePdf_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " FontSize="13"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════
                 FOOTER
                 ══════════════════════════════ -->
            <Border Grid.Row="2" Padding="28,10,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource CancelBtn}" Click="BtnCancel_Click">
                        <TextBlock Text="Cancel" FontSize="14" FontWeight="Bold" Foreground="#64748b"/>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource CreateBtn}" Click="BtnCreate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Book" FontSize="14" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
