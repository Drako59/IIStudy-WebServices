<Window x:Class="IIStudyDESKTOP.WindowsPages.EditBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        mc:Ignorable="d"
        Title="EditBook" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="EditBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#a5b4fc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UploadBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#667eea" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="White" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top: image + header -->
                <RowDefinition Height="*"/>
                <!-- Form -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 TOP SECTION — gradient bar with book image
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="20,20,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="28,20,28,20">
                    <Grid.ColumnDefinitions>
                        <!-- Book cover -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Divider -->
                        <ColumnDefinition Width="20"/>
                        <!-- Right: title + image browse -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── BOOK COVER (image + click to change) ── -->
                    <Grid Grid.Column="0" Width="100" VerticalAlignment="Center">
                        <!-- Shadow card -->
                        <Border Width="100" Height="138"
                                CornerRadius="12"
                                Background="White">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20"
                                                  ShadowDepth="0" Opacity="0.30"/>
                            </Border.Effect>
                            <Grid ClipToBounds="True">
                                <!-- Placeholder -->
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#eef2ff" Offset="0"/>
                                            <GradientStop Color="#f5f3ff" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="CoverEmoji"
                                           Text="📚" FontSize="40"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <!-- Actual image -->
                                <Border CornerRadius="12" ClipToBounds="True">
                                    <Image x:Name="CoverImage"
                                           Stretch="UniformToFill"
                                           Visibility="Collapsed"/>
                                </Border>
                                <!-- Hover overlay — "change image" hint -->
                                <Border x:Name="CoverOverlay"
                                        CornerRadius="12"
                                        Background="#80000000"
                                        Visibility="Collapsed"
                                        Cursor="Hand"
                                        >
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="🖼" FontSize="22"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Change"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Invisible overlay button to trigger hover effect -->
                        <Border Width="100" Height="138"
                                CornerRadius="12"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseEnter="Cover_MouseEnter"
                                MouseLeave="Cover_MouseLeave"
                                MouseLeftButtonUp="CoverOverlay_Click"/>
                    </Grid>

                    <!-- ── RIGHT SIDE: title info + image browse row ── -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">

                        <!-- Edit icon badge -->
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="White"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                            <TextBlock Text="✏️" FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Edit Book"
                                   FontSize="20" FontWeight="ExtraBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="TxtSubtitle"
                                   Text="Update book information"
                                   FontSize="12" Foreground="#ddd6fe"
                                   Margin="0,4,0,16"/>

                        <!-- Image browse inline -->
                        <TextBlock Text="COVER IMAGE" Style="{StaticResource FieldLabel}"
                                   Foreground="#c4b5fd" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,0"
                                    Height="36">
                                <TextBlock x:Name="TxtImagePath"
                                           Text="No image selected"
                                           FontSize="11"
                                           Foreground="#ddd6fe"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Grid.Column="2"
                                    Style="{StaticResource UploadBtn}"
                                    Background="White"
                                    BorderBrush="Transparent"
                                    Foreground="#667eea"
                                    Click="BrowseImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼 " FontSize="12"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════
                 FORM FIELDS
                 ══════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,18,28,10">
                <StackPanel>

                    <!-- Book Name + Author Name -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BOOK NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditBookName" Style="{StaticResource EditBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AUTHOR NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditAuthorName" Style="{StaticResource EditBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Price + Subject ID -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PRICE (₪)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditPrice" Style="{StaticResource EditBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SUBJECT ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditSubjectID" Style="{StaticResource EditBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Type + BookAuthor -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditType" Style="{StaticResource EditBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BOOK AUTHOR" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditBookAuthor" Style="{StaticResource EditBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- In Stock -->
                    <Border Background="#f8fafc" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <CheckBox x:Name="EditInStock" FontSize="13" FontWeight="SemiBold" Foreground="#1e293b">
                            <TextBlock Text="✅  Mark as In Stock" FontSize="13" FontWeight="SemiBold"/>
                        </CheckBox>
                    </Border>

                    <!-- PDF Upload -->
                    <TextBlock Text="PDF FILE" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <Border Background="#f8fafc" CornerRadius="12" Padding="14,12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#e2e8f0"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="10,0"
                                    Height="38">
                                <TextBlock x:Name="TxtPdfPath"
                                           Text="No PDF selected"
                                           FontSize="12"
                                           Foreground="#94a3b8"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Grid.Column="2"
                                    Style="{StaticResource UploadBtn}"
                                    Background="White"
                                    BorderBrush="#c7d2fe"
                                    Foreground="#667eea"
                                    >
                                <!--Click="BrowsePdf_Click"-->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " FontSize="13"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════
                 FOOTER BUTTONS
                 ══════════════════════════════ -->
            <Border Grid.Row="2" Padding="28,10,28,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource CancelBtn}" Click="BtnCancel_Click">
                        <TextBlock Text="← Back" FontSize="14" FontWeight="Bold" Foreground="#64748b"/>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource SaveBtn}" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Changes" FontSize="14" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
