<Window x:Class="IIStudyDESKTOP.WindowsPages.OrderDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP.WindowsPages"
        xmlns:converter ="clr-namespace:IIStudyDESKTOP"
        Icon="/Assets/IIStudy_WPF_Icon.ico"
        mc:Ignorable="d"
        Title="OrderDetails" Height="700" Width="520">
    <Window.Resources>
        <converter:StatusBackgroundConvertor x:Key="StatusBackgroundConverter">
            
        </converter:StatusBackgroundConvertor>
        <converter:StatusNameConverter x:Key="StatusNameConverter">
            
        </converter:StatusNameConverter>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
    </Window.Resources>

    <!-- Outer glow shadow -->
    <Border Margin="16" CornerRadius="22" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#667eea" BlurRadius="40" ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Hero -->
                <RowDefinition Height="*"/>
                <!-- Details body -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 HERO BANNER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="0" CornerRadius="22,22,0,0" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative blobs -->
                    <Ellipse Width="180" Height="180"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-70,-40,0" Opacity="0.10" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="100" Height="100"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-20,0,0,0" Opacity="0.08" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid Margin="22,18,16,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cart icon badge -->
                        <Border Grid.Column="0"
                                Width="52" Height="52"
                                CornerRadius="14"
                                Background="White"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Order ID + date -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ORDER DETAILS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#c4b5fd" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtHeroOrderID"
                                       Text="{Binding OrderID}"  
                                       FontSize="20" FontWeight="ExtraBold"
                                       Foreground="White"/>
                            <!--Add an # or Order # at start with a convertor-->
                            <TextBlock x:Name="TxtHeroDate"
                                       Text="{Binding Date}"
                                       FontSize="12" Foreground="#ddd6fe"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="Close_click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#ddd6fe"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕" FontSize="13" Foreground="White" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 DETAILS BODY
                 ══════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,18,22,10">
                <StackPanel>

                    <!-- Row 1: Order ID + Registered ID -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="ORDER ID" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔖 " FontSize="14"/>
                                    <TextBlock x:Name="TxtOrderID" Text="{Binding OrderID}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="REGISTERED ID" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " FontSize="14"/>
                                    <TextBlock x:Name="TxtRegisteredID" Text="{Binding RegisteredID}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Total Price (gradient) + Date -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="12" Padding="14,11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#eef2ff" Offset="0"/>
                                    <GradientStop Color="#f5f3ff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="TOTAL PRICE" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰 " FontSize="14"/>
                                    <TextBlock x:Name="TxtTotalPrice" Text="{Binding Total_price}"
                                               FontSize="18" FontWeight="ExtraBold">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#667eea" Offset="0"/>
                                                <GradientStop Color="#764ba2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InfoCard}">
                            <StackPanel>
                                <TextBlock Text="DATE" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 " FontSize="14"/>
                                    <TextBlock x:Name="TxtDate" Text="{Binding Date}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: DeliveryStatus (full width) -->
                    <Border Style="{StaticResource InfoCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DELIVERY STATUS" Style="{StaticResource InfoLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚚 " FontSize="14"/>
                                    <TextBlock x:Name="TxtDeliveryStatusLabel"
                                               FontSize ="13"
                                               FontWeight ="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding DeliveryStatus ,Converter={StaticResource StatusBackgroundConverter}}" 
                                               Text="{Binding DeliveryStatus ,Converter={StaticResource StatusNameConverter}}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Coloured status badge -->
                            <Border Grid.Column="1"
                                    x:Name="StatusBadge"
                                    CornerRadius="10" Padding="12,5"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatusBadge"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── LOCATION BLOCK ────────────────────────── -->
                    <Border Background="#f0f4ff" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="📍" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SHIPPING ADDRESS"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#667eea" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Address fields -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Location (full row) -->
                                <Border Grid.Row="0"
                                        Background="White" CornerRadius="10" Padding="12,9">
                                    <StackPanel>
                                        <TextBlock Text="LOCATION" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock x:Name="TxtLocation"
                                                   Text="{Binding Location}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1e293b"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- City + Postal + Country row -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- City -->
                                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="CITY" Style="{StaticResource InfoLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏙 " FontSize="13"/>
                                                <TextBlock x:Name="TxtCity"
                                                           Text="{Binding City}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1e293b"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Postal -->
                                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="POSTAL" Style="{StaticResource InfoLabel}"/>
                                            <TextBlock x:Name="TxtPostal"
                                                       Text="{Binding Postal}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#1e293b"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Country -->
                                    <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="12,9">
                                        <StackPanel>
                                            <TextBlock Text="COUNTRY" Style="{StaticResource InfoLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌍 " FontSize="13"/>
                                                <TextBlock x:Name="TxtCountry"
                                                           Text="{Binding Country}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1e293b"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── BOOKS LIST ─────────────────────────────── -->
                    <Border Background="#f8fafc" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📚" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ORDERED BOOKS"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#94a3b8" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#667eea" CornerRadius="8" Padding="7,2">
                                    <TextBlock x:Name="TxtBookCount"
                                               Text="0"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Book rows -->
                            <ItemsControl x:Name="BooksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                CornerRadius="10"
                                                Background="White"
                                                BorderBrush="#e0e7ff"
                                                BorderThickness="1"
                                                Padding="12,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="32" Height="32"
                                                        CornerRadius="8"
                                                        Background="#eef2ff"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="📖" FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Book_name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1e293b"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="2"
                                                        Background="#eef2ff"
                                                        CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="{Binding BookID}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#667eea"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- No books state -->
                            <Border x:Name="NoBooksState" Visibility="Collapsed" Padding="0,8">
                                <TextBlock Text="No books linked to this order."
                                           FontSize="12" Foreground="#94a3b8"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════
                 FOOTER
                 ══════════════════════════════════════════ -->
            <Border Grid.Row="2" Padding="22,10,22,20">
                <Button Height="44" BorderThickness="0" Cursor="Hand" Click="Close_click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#667eea" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.28"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Close" FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Button>
            </Border>

        </Grid>
    </Border>
</Window>
