<Window x:Class="IIStudyDESKTOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1860"
        ResizeMode="NoResize"
        >
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="15"></Setter>
            <Setter Property="Margin" Value="40"></Setter>
            <Setter Property="Height" Value="40"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="718*"/>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="1109*"/>
        </Grid.ColumnDefinitions>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="191*"/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>-->
        <StackPanel Orientation="Vertical" Background="#FFB7B2B2" Width="200" Margin="0,0,518,0" >
            <Button Content="Max Test" Style="{StaticResource ButtonStyle}" Click="Button_Click"></Button>
        </StackPanel>

    </Grid>

</Window>
