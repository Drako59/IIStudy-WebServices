<Window x:Class="IIStudyDESKTOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IIStudyDESKTOP"
        mc:Ignorable="d"
        Title="IIStudy - Admin Dashboard" 
        Height="1080" 
        Width="1920"
        WindowStartupLocation="CenterScreen"
        Background="#FF667EEA"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Gradient Background Brush -->
        <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4a5568"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,4,0"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f7fafc"/>
                                <Setter Property="Foreground" Value="#667eea"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#eef2ff"/>
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#667eea" Offset="0"/>
                                            <GradientStop Color="#764ba2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#667eea"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Sidebar Button Style -->
        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#eef2ff"/>
            <Setter Property="Foreground" Value="#667eea"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0e7ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sign Out Button Style -->
        <Style x:Key="SignOutButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ef4444"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#fee2e2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#fef2f2"/>
                                <Setter Property="BorderBrush" Value="#ef4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile Picture Style -->
        <Style x:Key="ProfilePicture" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Sidebar Navigation -->
        <Border DockPanel.Dock="Left"  
                Width="280"
                Background="White">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <Border Grid.Row="0" 
                        Padding="25,30"
                        BorderBrush="#f0f0f0"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock FontSize="28" 
                                  FontWeight="ExtraBold"
                                  Margin="0,0,0,5">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            📚 IIStudy
                        </TextBlock>
                        <TextBlock Text="Admin Dashboard"
                                  FontSize="12"
                                  Foreground="#94a3b8"
                                  FontWeight="Medium"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,20,0,0">
                    <StackPanel>
                        <!-- Navigation Label -->
                        <TextBlock Text="MAIN MENU"
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Foreground="#94a3b8"
                                  Margin="25,0,0,12"/>

                        <!-- Home Button -->
                        <Button Style="{StaticResource ActiveSidebarButton}" >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Books Button -->
                        <Button Style="{StaticResource SidebarButton}" 
                                Click="ViewBooks">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Books" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Exams Button -->
                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Exams" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Orders Button -->
                        <Button Style="{StaticResource SidebarButton}" Click="ViewOrders">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Orders" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Users Button -->
                        <Button Style="{StaticResource SidebarButton}" Click="ViewRegistereds">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Users" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Divider -->
                        <Border Height="1" 
                               Background="#f0f0f0" 
                               Margin="25,20,25,20"/>

                        <!-- Settings Label -->
                        <TextBlock Text="SETTINGS"
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Foreground="#94a3b8"
                                  Margin="25,0,0,12"/>

                        <!-- Calendar Button -->
                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Reports Button -->
                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Reports" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource SidebarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Profile Section at Bottom -->
                <Border Grid.Row="2" 
                        Padding="20"
                        BorderBrush="#f0f0f0"
                        BorderThickness="0,1,0,0"
                        Background="#fafbfc">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Profile Info -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Profile Picture -->
                            <Border Grid.Column="0" 
                                    Style="{StaticResource ProfilePicture}"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#667eea" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <!-- You can replace this with an Image control -->
                                <TextBlock Text="👤" 
                                          FontSize="24" 
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <!-- User Info -->
                            <StackPanel Grid.Column="1" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock Text="Admin User" 
                                          FontWeight="Bold"
                                          FontSize="14"
                                          Foreground="#1e293b"
                                          TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="admin@iistudy.com" 
                                          FontSize="11"
                                          Foreground="#64748b"
                                          TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sign Out Button -->
                        <Button Grid.Row="2"
                               Style="{StaticResource SignOutButton}"
                               >
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Sign Out" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Top Bar -->
        <Border DockPanel.Dock="Top"
                Background="White"
                Height="70"
                Padding="30,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Page Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Foreground="#1e293b"/>
                    <TextBlock Text="Welcome back! Here's what's happening today." 
                              FontSize="13"
                              Foreground="#64748b"
                              Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center"
                           >
                    <!-- Notifications -->
                    <Border Width="45" 
                           Height="45" 
                           Background="#f8fafc"
                           CornerRadius="12"
                           Cursor="Hand"
                           Padding="10">
                        <Grid>
                        
                        <Viewbox>
                            <TextBlock Text="🔔" VerticalAlignment="Center"/>
                        </Viewbox>
                        <!-- Notification Badge -->
                        <Border Width="18" 
                               Height="18" 
                               CornerRadius="9"
                               Background="#ef4444"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-5,-5,0">
                            <TextBlock Text="3" 
                                      Foreground="White" 
                                      FontSize="10"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        </Grid>
                    </Border>

                    <!-- Search -->
                    <Border Width="45" 
                           Height="45" 
                           Background="#f8fafc"
                           CornerRadius="12"
                           Cursor="Hand"
                           Padding="10">
                        <Viewbox>
                            <TextBlock Text="🔍" VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Background="{StaticResource GradientBackground}">
            <Frame x:Name="MainContent" 
                   NavigationUIVisibility="Hidden"
                   Margin="30"/>
        </Grid>
    </DockPanel>
</Window>