<UserControl x:Class="IIStudyDESKTOP.UserControllers.BookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IIStudyDESKTOP.UserControllers"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1700">

    <UserControl.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#667eea" 
                                                    BlurRadius="20" 
                                                    ShadowDepth="8" 
                                                    Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#667eea"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                                <Setter Property="Background" Value="#f7fafc"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                    Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4a5568"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer  
              Grid.Row="0"
              VerticalAlignment="Stretch"
             VerticalScrollBarVisibility="Auto"
             Margin="40,40,40,40">
        <Border Background="White" 
            CornerRadius="24" 
            Padding="50">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.15"/>
            </Border.Effect>

            <StackPanel>
                <!-- Page Title -->
                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                        Width="6" 
                        Height="40" 
                        CornerRadius="3"
                        Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Grid.Column="1" 
                          Text="Update Book Information" 
                          FontSize="32" 
                          FontWeight="ExtraBold"
                          Foreground="#2d3748"
                          VerticalAlignment="Center"/>
                </Grid>

                <!-- Form Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Book ID -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Book ID" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtBookID" 
                            Style="{StaticResource ModernTextBox}"
                            IsReadOnly="True"
                            Text="BK-12345"
                            Background="#f7fafc"/>
                    </StackPanel>

                    <!-- Book Name -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Book Name *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtBookName" 
                            Style="{StaticResource ModernTextBox}"
                            Text="To Kill a Mockingbird"/>
                    </StackPanel>

                    <!-- Author Name -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Author Name *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtAuthorName" 
                            Style="{StaticResource ModernTextBox}"
                            Text="Harper Lee"/>
                    </StackPanel>

                    <!-- Price -->
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Price ($) *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtPrice" 
                            Style="{StaticResource ModernTextBox}"
                            Text="24.99"/>
                    </StackPanel>

                    <!-- Subject -->
                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Subject *" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbSubject" 
                             Style="{StaticResource ModernComboBox}"
                             SelectedIndex="0">
                            <ComboBoxItem Content="Fiction"/>
                            <ComboBoxItem Content="Science"/>
                            <ComboBoxItem Content="History"/>
                            <ComboBoxItem Content="Technology"/>
                            <ComboBoxItem Content="Biography"/>
                            <ComboBoxItem Content="Philosophy"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Pages -->
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Number of Pages" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtPages" 
                            Style="{StaticResource ModernTextBox}"
                            Text="336"/>
                    </StackPanel>

                    <!-- ISBN -->
                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="ISBN" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtISBN" 
                            Style="{StaticResource ModernTextBox}"
                            Text="978-0-06-112008-4"/>
                    </StackPanel>

                    <!-- Publication Year -->
                    <StackPanel Grid.Row="6" Grid.Column="2">
                        <TextBlock Text="Publication Year" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtPublicationYear" 
                            Style="{StaticResource ModernTextBox}"
                            Text="1960"/>
                    </StackPanel>

                    <!-- In Stock -->
                    <StackPanel Grid.Row="8" Grid.Column="0">
                        <TextBlock Text="Availability" Style="{StaticResource FormLabel}"/>
                        <CheckBox x:Name="chkInStock" 
                             Content="In Stock" 
                             IsChecked="True"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="#4a5568"
                             Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Format -->
                    <StackPanel Grid.Row="8" Grid.Column="2">
                        <TextBlock Text="Format" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cmbFormat" 
                             Style="{StaticResource ModernComboBox}"
                             SelectedIndex="0">
                            <ComboBoxItem Content="PDF"/>
                            <ComboBoxItem Content="EPUB"/>
                            <ComboBoxItem Content="Hardcover"/>
                            <ComboBoxItem Content="Paperback"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Description" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtDescription" 
                            Style="{StaticResource ModernTextBox}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Height="120"
                            VerticalScrollBarVisibility="Auto"
                            Text="A gripping, heart-wrenching, and wholly remarkable tale of coming-of-age in a South poisoned by virulent prejudice."/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           >
                        <Button Content="Cancel" 
                           Style="{StaticResource SecondaryButton}"
                           Width="140"
                           />
                        <!--Click="CancelButton_Click"-->
                        <Button Content="Update Book" 
                           Style="{StaticResource ModernButton}"
                           Width="160"
                           />
                        <!--Click="UpdateButton_Click"-->
                    </StackPanel>
                </Grid>

                <!-- Info Message -->
                <Border Background="#eef2ff" 
                   BorderBrush="#c7d2fe" 
                   BorderThickness="2"
                   CornerRadius="12"
                   Padding="16"
                   Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️" 
                              FontSize="20" 
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>
                        <TextBlock TextWrapping="Wrap"
                              Foreground="#4338ca"
                              FontSize="13">
                        <Run FontWeight="SemiBold">Note:</Run>
                        <Run>Fields marked with * are required. Make sure all information is accurate before updating.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
