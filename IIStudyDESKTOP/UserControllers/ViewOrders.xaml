<UserControl x:Class="IIStudyDESKTOP.UserControllers.ViewOrders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IIStudyDESKTOP.UserControllers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Header style for table columns -->
        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <!-- Cell text style -->
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Badge style for Delivered -->
        <Style x:Key="DeliveredBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Row hover style via ListViewItem -->
        <Style x:Key="OrderRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="rowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#f1f5f9"
                                BorderThickness="0,0,0,1"
                                Padding="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#f8faff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#eef2ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Chip Style -->
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Page title -->
            <RowDefinition Height="Auto"/>
            <!-- Stats row -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Table -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             ROW 0 – Page Title
             ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Orders"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Manage and track all customer orders"
                       FontSize="14"
                       Foreground="#ddd6fe"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════
             ROW 1 – Summary Stats Cards
             ═══════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">

            <!-- Total Orders -->
            <Border Margin="0,0,12,0" CornerRadius="16" Background="White" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Orders" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtTotalOrders" Text="—"
                               FontSize="30" FontWeight="ExtraBold" Foreground="#1e293b" Margin="0,6,0,0"/>
                    <TextBlock Text="All time" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Delivered -->
            <Border Margin="6,0" CornerRadius="16" Background="White" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Delivered" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtDelivered" Text="—"
                               FontSize="30" FontWeight="ExtraBold" Foreground="#22c55e" Margin="0,6,0,0"/>
                    <TextBlock Text="Completed orders" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending -->
            <Border Margin="6,0" CornerRadius="16" Background="White" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Pending" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtPending" Text="—"
                               FontSize="30" FontWeight="ExtraBold" Foreground="#f59e0b" Margin="0,6,0,0"/>
                    <TextBlock Text="Awaiting delivery" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Revenue -->
            <Border Margin="12,0,0,0" CornerRadius="16" Background="White" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Revenue" FontSize="12" FontWeight="SemiBold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtRevenue" Text="—"
                               FontSize="30" FontWeight="ExtraBold" Margin="0,6,0,0">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#667eea" Offset="0"/>
                                <GradientStop Color="#764ba2" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="Sum of all orders" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════════════════════════════════════
             ROW 2 – Toolbar (search + filter chips)
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="16,12"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0"
                        Background="#f8fafc"
                        CornerRadius="10"
                        Padding="12,8"
                        MaxWidth="340"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#334155"
                                 VerticalAlignment="Center"
                                 Width="240"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <!--Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static BooleanToVisibilityConverter}}"-->

                                                    <TextBlock Text="Search orders, locations, books..."
                                                               Foreground="#94a3b8"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FilterChip}"
                            x:Name="FilterAll"
                            Content="All Orders"
                            Background="#667eea"
                            Foreground="White"
                            Margin="0,0,8,0"
                            Click="Filter_All"/>
                    <Button Style="{StaticResource FilterChip}"
                            x:Name="FilterDelivered"
                            Content="✅ Delivered"
                            Background="#f0fdf4"
                            Foreground="#16a34a"
                            Margin="0,0,8,0"
                            Click="Filter_Delivered"/>
                    <Button Style="{StaticResource FilterChip}"
                            x:Name="FilterPending"
                            Content="⏳ Pending"
                            Background="#fffbeb"
                            Foreground="#d97706"
                            Click="Filter_Pending"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════
             ROW 3 – Orders Table
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Column headers -->
                    <RowDefinition Height="*"/>
                    <!-- Data rows -->
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0"
                        Background="#f8fafc"
                        BorderBrush="#f1f5f9"
                        BorderThickness="0,0,0,1"
                        Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <!-- Order ID -->
                            <ColumnDefinition Width="80"/>
                            <!-- Registered ID -->
                            <ColumnDefinition Width="*"/>
                            <!-- Books (linked) -->
                            <ColumnDefinition Width="120"/>
                            <!-- Location -->
                            <ColumnDefinition Width="110"/>
                            <!-- Total Price -->
                            <ColumnDefinition Width="110"/>
                            <!-- Date -->
                            <ColumnDefinition Width="100"/>
                            <!-- Status -->
                            <ColumnDefinition Width="90"/>
                            <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Order ID"   Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="1" Text="User ID"    Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="2" Text="Books"      Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="3" Text="Location"   Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="4" Text="Total (₪)"  Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="5" Text="Date"       Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="6" Text="Status"     Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="7" Text="Actions"    Style="{StaticResource TableHeader}"/>
                    </Grid>
                </Border>

                <!-- Data Rows -->
                <ListView Grid.Row="1"
                          x:Name="OrdersListView"
                          ItemContainerStyle="{StaticResource OrderRowStyle}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          >
                    <!--SelectionChanged="OrdersListView_SelectionChanged"-->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Order ID -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding OrderID}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#667eea"
                                               VerticalAlignment="Center"/>

                                    <!-- User / Registered ID -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RegisteredID}"
                                               Style="{StaticResource TableCell}"/>

                                    <!-- Books (linked) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Books}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#f0f4ff"
                                                            CornerRadius="6"
                                                            Padding="8,3"
                                                            Margin="0,2,4,2"
                                                            HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📖 " FontSize="12"/>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       Foreground="#4338ca"
                                                                       FontWeight="SemiBold"
                                                                       MaxWidth="200"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Location -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📍 " FontSize="13"/>
                                        <TextBlock Text="{Binding Location}"
                                                   Style="{StaticResource TableCell}"
                                                   MaxWidth="90"/>
                                    </StackPanel>

                                    <!-- Total Price -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding TotalPrice, StringFormat='₪{0:N0}'}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#1e293b"
                                               VerticalAlignment="Center"/>

                                    <!-- Date -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                               Style="{StaticResource TableCell}"
                                               Foreground="#64748b"/>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="6"
                                            CornerRadius="8"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding DeliveredBackground}">
                                        <TextBlock Text="{Binding DeliveredLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DeliveredForeground}"/>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="7"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource ActionBtn}"
                                                ToolTip="View Details"
                                                Background="#eff6ff"
                                                Foreground="#3b82f6"
                                                Content="👁"
                                                Margin="0,0,6,0"
                                                Tag="{Binding OrderID}"
                                                />
                                        <Button Style="{StaticResource ActionBtn}"
                                                ToolTip="Toggle Delivery"
                                                Background="#f0fdf4"
                                                Foreground="#16a34a"
                                                Content="🚚"
                                                Tag="{Binding OrderID}"
                                               />
                                        <!--Click="ToggleDelivery_Click"-->
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <Border Grid.Row="1"
                        x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="40">
                    <!--<StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🛒" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="No orders found"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,6"/>
                        <TextBlock Text="Try adjusting your search or filter."
                                   FontSize="13"
                                   Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>-->
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
