<UserControl x:Class="IIStudyDESKTOP.UserControllers.RegisteredsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IIStudyDESKTOP.UserControllers"
             xmlns:convertor="clr-namespace:IIStudyDESKTOP"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <convertor:UrlConverter x:Key="UrlConverter">

        </convertor:UrlConverter>
        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748b"/>
        </Style>

        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="UserRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="rowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#f1f5f9"
                                BorderThickness="0,0,0,1"
                                Padding="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#f8faff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="#eef2ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder"
                                Property="Opacity"
                                Value="0.85"/>
                                <Setter TargetName="btnBorder"
                                Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Press -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder"
                                Property="Opacity"
                                Value="0.7"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!--<Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>-->
        </Style>

        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Users"
                       FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Manage all registered users"
                       FontSize="14" Foreground="#ddd6fe" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">

            <Border Margin="0,0,10,0" CornerRadius="14" Background="White" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Users" FontSize="11" FontWeight="Bold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtTotal" Text="0"
                               FontSize="28" FontWeight="ExtraBold" Foreground="#1e293b" Margin="0,6,0,0"/>
                    <TextBlock Text="All accounts" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Margin="5,0" CornerRadius="14" Background="White" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Admins" FontSize="11" FontWeight="Bold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtAdmins" Text="0"
                               FontSize="28" FontWeight="ExtraBold" Foreground="#667eea" Margin="0,6,0,0"/>
                    <TextBlock Text="Admin role" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Margin="5,0" CornerRadius="14" Background="White" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Banned" FontSize="11" FontWeight="Bold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtBanned" Text="0"
                               FontSize="28" FontWeight="ExtraBold" Foreground="#e32b1e" Margin="0,6,0,0"/>
                    <TextBlock Text="Banned Users" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Margin="10,0,0,0" CornerRadius="14" Background="White" Padding="18">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Regular Users" FontSize="11" FontWeight="Bold" Foreground="#94a3b8"/>
                    <TextBlock x:Name="TxtUsers" Text="0"
                               FontSize="28" FontWeight="ExtraBold" Foreground="#22c55e" Margin="0,6,0,0"/>
                    <TextBlock Text="User role" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Toolbar -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0"
                        Background="#f8fafc"
                        CornerRadius="8"
                        Padding="10,6"
                        MaxWidth="320"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#334155"
                                 VerticalAlignment="Center"
                                 Width="220"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Border>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="FilterAll"
                            Style="{StaticResource FilterChip}"
                            Content="All"
                            Background="#667eea"
                            Foreground="White"
                            Margin="0,0,8,0"
                            Click="Filter_All"/>
                    <Button x:Name="FilterAdmins"
                            Style="{StaticResource FilterChip}"
                            Content="👑 Admins"
                            Background="#eef2ff"
                            Foreground="#667eea"
                            Margin="0,0,8,0"
                            Click="Filter_Admins"/>
                    <Button x:Name="FilterBanned"
                            Style="{StaticResource FilterChip}"
                            Content="🚫 Banned"
                            Background="#ffe2e0"
                            Foreground="#e32b1e"
                            Margin="0,0,8,0"
                            Click="Filter_Banned"/>
                    <Button x:Name="FilterUsers"
                            Style="{StaticResource FilterChip}"
                            Content="👤 Users"
                            Background="#f0fdf4"
                            Foreground="#16a34a"
                            Click="Filter_Users"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Users Table -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="0" Opacity="0.07"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border Grid.Row="0"
                        Background="#f8fafc"
                        BorderBrush="#f1f5f9"
                        BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#"           Style="{StaticResource TableHeader}"/>
                        <!--<TextBlock Grid.Column="7" Text="Image"       Style="{StaticResource TableHeader}"/>-->
                        <TextBlock Grid.Column="1" Text="Username"    Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="2" Text="Email"       Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="3" Text="Role"        Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="4" Text="Birth Date"  Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="5" Text="Reg. ID"     Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="6" Text="Phone"       Style="{StaticResource TableHeader}"/>
                        <TextBlock Grid.Column="8" Text="Actions"     Style="{StaticResource TableHeader}"/>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ListView Grid.Row="1"
                          x:Name="UsersListView"
                          ItemContainerStyle="{StaticResource UserRowStyle}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Reg ID -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding RegisteredID}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="#667eea"
                                               VerticalAlignment="Center"/>

                                    <!-- Username with avatar -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                        <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="#e0e7ff"
                                            BorderThickness="2"
                                            ClipToBounds="True">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding RegisteredID,
                                           Converter={StaticResource UrlConverter},
                                           ConverterParameter=Registered}"
                                            Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- Username -->
                                        <TextBlock Text="{Binding UserName}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#1e293b"/>

                                        <!--<Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Margin="0,0,10,0"
                                            BorderThickness="2"
                                            BorderBrush="#e0e7ff"
                                            Background="#f1f5ff">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.25"/>
                                        </Border.Effect>

                                        <Image Source="{Binding RegisteredID,
                                                                Converter={StaticResource UrlConverter},
                                                                ConverterParameter=Registered}"
                                               Stretch="UniformToFill"
                                               ClipToBounds="True">
                                            --><!--<Image.Clip>
                                                <EllipseGeometry Center="18,18"
                                                                 RadiusX="18"
                                                                 RadiusY="18"/>
                                            </Image.Clip>--><!--
                                        </Image>
                                    </Border>

                                    --><!-- Username --><!--
                                    <TextBlock Text="{Binding UserName}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#1e293b"
                                               VerticalAlignment="Center"
                                               MaxWidth="110"
                                               TextTrimming="CharacterEllipsis"/>-->
                                        <!--<Border Width="32" Height="32" CornerRadius="16"
                                                Background="{Binding AvatarColor}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding UserName}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#1e293b"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="110"
                                                   TextTrimming="CharacterEllipsis"/>-->
                                    </StackPanel>

                                    <!-- Email -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Email}"
                                               Style="{StaticResource TableCell}"
                                               Foreground="#64748b"
                                               MaxWidth="170"/>

                                    <!-- Role Badge -->
                                    <Border Grid.Column="3"
                                            CornerRadius="8" Padding="10,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{Binding RoleBackground}">
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding RoleForeground}"/>
                                    </Border>

                                    <!-- Birth Date -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Birth}"
                                               Style="{StaticResource TableCell}"
                                               Foreground="#64748b"/>

                                    <!-- Registered ID -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding RegisteredID}"
                                               Style="{StaticResource TableCell}"/>

                                    <!-- Phone -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding Phone}"
                                               Style="{StaticResource TableCell}"
                                               Foreground="#64748b"/>

                                    <!-- Image Path -->
                                    <!--<TextBlock Grid.Column="7"
                                               Text="{Binding ImagePath}"
                                               Style="{StaticResource TableCell}"
                                               Foreground="#94a3b8"
                                               FontSize="11"
                                               MaxWidth="120"/>-->

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ActionBtn}"
                                                Background="#eff6ff"
                                                Content="👁"
                                                ToolTip="View Info"
                                                Margin="0,0,6,0"
                                                Tag="{Binding}"
                                                Click="ShowRegisteredDetails"/>
                                        <!--<Button Style="{StaticResource ActionBtn}"
                                                Background="#fef2f2"
                                                Content="🗑"
                                                ToolTip="Remove User"
                                                Tag="{Binding RegisteredID}"
                                                Click="DeleteUser_Click"/>-->
                                        <Button Click="ToggleBanButton"
                                                    Tag="{Binding}">

                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">

                                                    <!-- ברירת מחדל = DELETE -->
                                                    <Setter Property="Content" Value="🔒"/>
                                                    <Setter Property="Foreground" Value="#ef4444"/>

                                                    <Style.Triggers>

                                                        <!-- אם הספר לא פעיל -->
                                                        <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                            <Setter Property="Content" Value="🔑"/>
                                                            <Setter Property="Foreground" Value="#16a34a"/>
                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </Button.Style>

                                        </Button>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <Border Grid.Row="1"
                        x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="No users found"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#64748b"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="Try adjusting your search or filter."
                                   FontSize="12" Foreground="#94a3b8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
