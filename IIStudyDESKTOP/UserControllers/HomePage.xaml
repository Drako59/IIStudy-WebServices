                                               Foreground="#94a3b8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource NavBtn}"
                                        Background="#059669"
                                        Click="GoToCalendar_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open" FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                        <TextBlock Text=" →" FontSize="11" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Margin="16,10,16,16">

                            <TextBlock Text="POPUP WINDOWS" FontSize="9" FontWeight="Bold"
                                       Foreground="#94a3b8" Margin="2,0,0,8"/>

                            <Border Style="{StaticResource FuncRow}" Background="#f8fafc"
                                    >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add New Event" FontSize="12" FontWeight="SemiBold"
