                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FuncRow}" Background="#f8fafc"
                                   >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✏️" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Edit Event" FontSize="12" FontWeight="SemiBold"
