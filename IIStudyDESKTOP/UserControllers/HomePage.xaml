                    <Border.Effect>
                        <DropShadowEffect Color="#667eea" BlurRadius="18"
                                          ShadowDepth="0" Opacity="0.07"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- Card header -->
                        <Border CornerRadius="18,18,0,0" Padding="18,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#eef2ff" Offset="0"/>
                                    <GradientStop Color="#f5f3ff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="13"
                                        Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#667eea" Offset="0"/>
                                            <GradientStop Color="#764ba2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#667eea" BlurRadius="10"
                                                          ShadowDepth="0" Opacity="0.35"/>
                                    </Border.Effect>
                                    <TextBlock Text="📚" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Books" FontSize="16" FontWeight="ExtraBold"
                                               Foreground="#0f172a"/>
                                    <TextBlock Text="Book inventory" FontSize="11"
                                               Foreground="#94a3b8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Go to page button -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource NavBtn}"
                                        Background="#667eea"
                                        Click="GoToBooks_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open" FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                        <TextBlock Text=" →" FontSize="11" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Actions list -->
                        <StackPanel Margin="16,10,16,16">

                            <TextBlock Text="POPUP WINDOWS" FontSize="9" FontWeight="Bold"
                                       Foreground="#94a3b8" Margin="2,0,0,8"/>

                            <Border Style="{StaticResource FuncRow}" Background="#f8fafc"
                                    >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add New Book" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1e293b" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FuncRow}" Background="#f8fafc"
