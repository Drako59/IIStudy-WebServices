<UserControl x:Class="IIStudyDESKTOP.UserControllers.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IIStudyDESKTOP.UserControllers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Navigation button (goes to page) -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Function row (action inside a section) -->
        <Style x:Key="FuncRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Hero header -->
                <RowDefinition Height="Auto"/>
                <!-- Cards grid -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 HERO HEADER
                 ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0">
                <!--<Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>-->

                <Grid Margin="32,26,32,26">
                    <!-- Decorative blob -->
                    <Ellipse Width="220" Height="220"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-80,-60,0" Opacity="0.10"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel>
                        <!-- Logo pill -->
                        <Border HorizontalAlignment="Left"
                                CornerRadius="12" Padding="14,8"
                                Background="White" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="2.5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2.5"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="2" Background="#667eea"/>
                                    <Border Grid.Row="0" Grid.Column="2" CornerRadius="2" Background="#667eea"/>
                                    <Border Grid.Row="2" Grid.Column="0" CornerRadius="2" Background="#667eea"/>
                                    <Border Grid.Row="2" Grid.Column="2" CornerRadius="2" Background="#667eea"/>
                                </Grid>
                                <TextBlock FontSize="16" FontWeight="ExtraBold" Foreground="#667eea">
                                    <Run Text="II" FontWeight="Black"/>
                                    <Run Text="Study" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Admin Dashboard"
                                   FontSize="26" FontWeight="ExtraBold"
                                   Foreground="White"/>
                        <TextBlock Text="Quick access to all management sections and actions"
                                   FontSize="13" Foreground="White"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 SECTION CARDS GRID
                 ══════════════════════════════════════════════════════ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="28,24,28,28">

                <!-- ─────────────────────────────────────
                     📚 BOOKS
                     ───────────────────────────────────── -->
