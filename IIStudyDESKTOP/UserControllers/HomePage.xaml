                                    <TextBlock Text="Delete Event" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#dc2626" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FuncRow}" Background="#e0f0ff">
