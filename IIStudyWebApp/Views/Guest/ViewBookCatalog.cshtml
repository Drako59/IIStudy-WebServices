<link rel="stylesheet" href="../Css/bookCatalog_claude.css">

<section class="search-section">
    <div class="container">

        <div class="catalog-toolbar">

            <!-- כפתור שלושת הקווים -->
            <button type="button"
                    class="filters-menu-button"
                    onclick="openFiltersSidebar()"
                    aria-label="Open filters">

                <span></span>
                <span></span>
                <span></span>

            </button>

            <!-- החיפוש הקיים -->
            <div class="search-container">
                <input type="text"
                       id="search-input"
                       name="SEARCH"
                       class="search-input"
                       value="@Model?.Search"
                       placeholder="Search for books, authors, categories...">

                <div class="search-icon">🔍</div>
            </div>

        </div>

    </div>
</section>

<!-- רקע כהה מאחורי ה-Sidebar -->
<div id="filters-overlay"
     class="filters-overlay"
     onclick="closeFiltersSidebar()">
</div>


<!-- Sidebar Filters -->
<aside id="filters-sidebar"
       class="filters-sidebar">

    <div class="filters-sidebar-header">

        <div>
            <h2>Book Filters</h2>
            <p>Choose the books you want to display</p>
        </div>

        <button type="button"
                class="close-filters-button"
                onclick="closeFiltersSidebar()">
            ×
        </button>

    </div>


    <form method="get"
          action="@Url.Action("ViewBookCatalog", "Guest")"
          class="filters-form">

        <!-- Subject -->
        <div class="filter-group">

            <label for="subjectID">
                Subject
            </label>

            <select id="subjectID"
                    class="filter-select" asp-for="SubjectID">
                    
                <option value="">
                    All Subjects
                </option>
                @if(Model != null && Model.Subjects != null && Model.Subjects.Any()){
                @foreach(Subject subject in Model.Subjects)
                {
                    <option value="@subject.SubjectID">
                        @subject.Subject_name
                    </option>
                }
                }

            </select>

        </div>


        <!-- Price -->
        <div class="filter-group">

            <label>
                Price Range
            </label>

            <div class="price-inputs">

                <div class="price-input-wrapper">
                    <span>₪</span>

                    <input type="number"
                           name="minPrice"
                           placeholder="Min"
                           min="0"
                           step="0.01"
                           asp-for="MinPrice"
                    >
                </div>

                <span class="price-divider">—</span>

                <div class="price-input-wrapper">
                    <span>₪</span>

                    <input type="number"
                           name="maxPrice"
                           placeholder="Max"
                           min="0"
                           step="0.01"
                           asp-for="MaxPrice">
                </div>

            </div>

        </div>


        <!-- In Stock -->
        <div class="filter-group">

            <label class="filter-option">

                <input type="checkbox"
                       name="inStock"
                       asp-for="In_stock">

                <span class="filter-option-checkbox">
                    ✓
                </span>

                <span class="filter-option-information">
                    <strong>In Stock</strong>
                    <small>Show books currently in stock</small>
                </span>

                <span class="filter-option-dot stock-dot"></span>

            </label>

        </div>


        <!-- Online Books -->
        <div class="filter-group">

            <label class="filter-option">

                <input type="checkbox"
                       name="isOnline"
                       asp-for="IsOnline">

                <span class="filter-option-checkbox">
                    ✓
                </span>

                <span class="filter-option-information">
                    <strong>Online Books</strong>
                    <small>Show online books only</small>
                </span>

                <span class="filter-option-dot online-dot"></span>

            </label>

        </div>
         <!-- Physical Books -->
        <div class="filter-group">

            <label class="filter-option">

                <input type="checkbox"
                       name="isPhysical"
                       asp-for="IsPhysical">

                <span class="filter-option-checkbox">
                    ✓
                </span>

                <span class="filter-option-information">
                    <strong>Physical Books</strong>
                    <small>Show Physical books only</small>
                </span>

                <span class="filter-option-dot online-dot"></span>

            </label>

        </div>

         <input type="hidden" name="search" asp-for="Search"/>

        <div class="filters-form-buttons">

            <!-- מאפס את הפילטרים באמצעות מעבר לעמוד בלי Query String -->
            <a href="@Url.Action("ViewBookCatalog", "Guest")"
               class="clear-filters-button">
                Clear
            </a>

            <!-- שולח את הטופס לשרת -->
            <button type="submit"
                    class="apply-filters-button">
                Apply Filters
            </button>

        </div>

    </form>

</aside>

<!-- Main Content -->
<main class="main-content">

    <div class="container">
        <div class="books-grid">
            <!-- Book Cards -->
            @* @if (Model != null && Model.Any())
            {
                @foreach (Book book in Model)
                {
                    <div class="book-card">
                            <span class="category-tag">Fiction</span>
                        <div class="book-image">
                            <img class="image_div" src="../Images/HomePage_Guest_Images/0b9b4d7903c0f8b8cdd4d451e7ae3d19.jpg">
                        </div>
                        <h3 class="book-title">@book.Book_name</h3>
                        <div class="book-actions">
                            <button class="action-btn btn-add-cart">Add to Cart</button>
                            <button class="action-btn btn-preview">Preview</button>
                        </div>
                    </div>
                }
            } *@





            @if (Model != null && Model.Books != null && Model.Books.Any())
            {
                @foreach (GuestBookDetails book in Model.Books)
                {
                    if (book.In_stock)
                    {
                        string path = $"{@Url.Action("ViewBookPreview", "Guest", new { bookID = book.BookID })}";
                        <div class="book-card" data-title="@book.Book_name">
                            <a href=@path class="book-cover">
                                @if (!string.IsNullOrWhiteSpace(book.SubjectID))
                                {
                                    <span class="book-subject-tag">
                                        @book.Subject_name
                                    </span>
                                }
                                <img class="image_div" src="@Url.Action("GetBookImage", "Guest", new { bookID = book.BookID })">
                            </a>
                        <div class="book-info">
                            <div class="book-title-row">
                                <h3>@book.Book_name</h3>

                                @if (book.IsOnline)
                                {
                                    <span class="digital-pdf-badge" title="Digital PDF Book">
                                        <svg viewBox="0 0 24 24">
                                            <path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                            <path d="M14 2v6h6"></path>
                                            <path d="M8 13h1.8a1.4 1.4 0 0 1 0 2.8H8z"></path>
                                            <path d="M13 13v5"></path>
                                            <path d="M13 13h1.2a2.5 2.5 0 0 1 0 5H13"></path>
                                            <path d="M18 13h2"></path>
                                            <path d="M18 15.5h1.5"></path>
                                            <path d="M18 13v5"></path>
                                        </svg>
                                        PDF
                                    </span>
                                }
                                else
                                {
                                    <div class="title-stock-box">
                                        <span class="stock-side-badge @(book.StockCount <= 3 ? "low" : "")" title="Books in stock">
                                            <svg viewBox="0 0 24 24">
                                                <path d="M21 16V8a2 2 0 0 0-1-1.73L13 2.27a2 2 0 0 0-2 0L4 6.27A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                <path d="M3.3 7L12 12l8.7-5"></path>
                                                <path d="M12 22V12"></path>
                                            </svg>

                                            <span>@book.StockCount</span>
                                        </span>

                                        <small class="stock-side-label">in stock</small>
                                    </div>
                                }
                            </div>
                            <p class="book-author">@book.Author_name</p>
                            <p class="book-price">₪@book.Book_price</p>
                                <button class="add-to-cart" onclick="window.location.href='@(Url.Action("viewSignInPage", "Guest"))';">
                                @* <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg> *@
                                Add to Cart
                                </button>
                        </div>
                        </div>
                    }
                    else
                    {
                        string path = $"{@Url.Action("ViewBookPreview", "Guest", new { bookID = book.BookID })}";
                        <div class="book-card" data-title="@book.Book_name">
                            <a href=@path class="book-cover">
                                @if (!string.IsNullOrWhiteSpace(book.SubjectID))
                                {
                                    <span class="book-subject-tag">
                                        @book.Subject_name
                                    </span>
                                }
                                <img class="image_div" src="@Url.Action("GetBookImage", "Guest", new { bookID = book.BookID })">
                            </a>
                            <div class="book-info">
                                <div class="book-title-row">
                                    <h3>@book.Book_name</h3>

                                    @if (book.IsOnline)
                                    {
                                        <span class="digital-pdf-badge" title="Digital PDF Book">
                                            <svg viewBox="0 0 24 24">
                                                <path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                                <path d="M14 2v6h6"></path>
                                                <path d="M8 13h1.8a1.4 1.4 0 0 1 0 2.8H8z"></path>
                                                <path d="M13 13v5"></path>
                                                <path d="M13 13h1.2a2.5 2.5 0 0 1 0 5H13"></path>
                                                <path d="M18 13h2"></path>
                                                <path d="M18 15.5h1.5"></path>
                                                <path d="M18 13v5"></path>
                                            </svg>
                                            PDF
                                        </span>
                                    }
                                    
                                </div>
                                <p class="book-author">@book.Author_name</p>
                                <p class="book-price">₪@book.Book_price</p>
                                <button class="add-to-cart error" disabled onclick="window.location.href='@(Url.Action("viewSignInPage", "Guest"))';">
                                    @* <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg> *@
                                    Out of stock
                                </button>
                            </div>
                        </div>
                    }
                }
            }


        
        </div>
        
        
        @if(Model != null && Model.TotalPages > 1)
            {
                int currentPage = Model.PageNumber;
                int totalPages = Model.TotalPages;

        <div class="catalog-pagination">
        
            @if ( 1 < currentPage)
            {
                <a class="pagination-arrow"
                   href="@Url.Action("ViewBookCatalog", "Guest", new {
                       pageNumber = Model.PageNumber - 1,
                       subjectID = Model?.SubjectID,
                       minPrice = Model?.MinPrice,
                       maxPrice = Model?.MaxPrice,
                       inStock = Model?.In_stock,
                       isOnline = Model?.IsOnline,
                       search = Model?.Search
                   })">
                    ‹
                </a>
            }
            else
            {
                <span class="pagination-arrow disabled">‹</span>
            }

            <span class="pagination-page-number">
                @Model.PageNumber
            </span>

            @if (currentPage < totalPages)
            {
                <a class="pagination-arrow"
                   href="@Url.Action("ViewBookCatalog", "Guest", new {
                       pageNumber = Model.PageNumber + 1,
                       subjectID = Model?.SubjectID,
                       minPrice = Model?.MinPrice,
                       maxPrice = Model?.MaxPrice,
                       inStock = Model?.In_stock,
                       isOnline = Model?.IsOnline,
                       search = Model?.Search
                   })">
                    ›
                </a>
            }
            else
            {
                <span class="pagination-arrow disabled">›</span>
            }

    </div>
    }
        


    </div>
</main>
<script src="~/js/bookcatalog.js"></script>
<script>
    

     function searchBooks() {
        const searchTerm = document.getElementById('search-input').value.toLowerCase();
        const bookCards = document.querySelectorAll('.book-card');

        bookCards.forEach(card => {
            const title = card.dataset.title.toLowerCase();
            const author = card.querySelector(".book-author").textContent.toLowerCase();
            if (title.includes(searchTerm) || author.includes(searchTerm)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }


            function openFiltersSidebar() {
        const sidebar = document.getElementById("filters-sidebar");
        const overlay = document.getElementById("filters-overlay");

        sidebar.classList.add("open");
        overlay.classList.add("visible");

        document.body.classList.add("filters-sidebar-open");
    }


    function closeFiltersSidebar() {
        const sidebar = document.getElementById("filters-sidebar");
        const overlay = document.getElementById("filters-overlay");

        sidebar.classList.remove("open");
        overlay.classList.remove("visible");

        document.body.classList.remove("filters-sidebar-open");
    }


    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeFiltersSidebar();
        }
    });
</script>