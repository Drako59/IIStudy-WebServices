
@{
    ViewData["Title"] = "ViewBookPreview";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}

@using LLStudy_Models.Models
@using LLStudy_Models.ViewModels
@model ViewBookViewModel

<link href="~/css/bookpreview.css" rel="stylesheet" />

<div class="book-details-page">
    <div class="container">
        <div class="breadcrumb">
            <a href="#">Home</a> / <a href="#">Fiction</a> / <strong>@Model.book.Book_name</strong>
        </div>

        <!-- Main Book Information -->
        <div class="book-main-section">
            <div class="book-header">
                <div class="book-cover-main">
                    <img class="book-cover-image" src="@Url.Action("GetBookImage", "Guest", new { bookID = Model.book.BookID })" /> <!-- CHANE TO A REAL IMAGE-->
                    @* <svg viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M7 8h10M7 12h8M7 16h6" />
                    </svg> *@
                </div>

                <div class="book-info-main">
                    @if (Model.book.In_stock)
                    {
                        <span class="stock-badge in-stock">
                            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none;">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            In Stock
                        </span>
                    }
                    else
                    {
                        <span class="stock-badge out-stock">
                            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none;">
                                <path d="M6 6L18 18M18 6L6 18"></path>
                            </svg>
                            Out Stock
                        </span>
                    }

                    <h1 class="book-title-main">@Model.book.Book_name</h1>
                    <p class="book-author-main">@Model.book.Author_name</p>

                     <div class="rating-section">
                        <div class="stars-large">
                            @{
                                int totalStars = 5;
                                double starsAmount = Math.Floor(Model.Rate) ;
                                
                                for (int i = 0; i < starsAmount; i++)
                                {
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#FACC15" />
                                    </svg>


                                }
                                if (Model.Rate - starsAmount > 0)
                                {
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <defs>
                                            <!-- חצי שמאלי של הכוכב -->
                                            <clipPath id="star-half-left">
                                                <rect x="0" y="0" width="12" height="24" />
                                            </clipPath>
                                        </defs>

                                        <!-- רקע אפור (כוכב ריק) -->
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#E5E7EB" />

                                        <!-- חצי צהוב מעל -->
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#FACC15"
                                              clip-path="url(#star-half-left)" />
                                    </svg>

                                }
                                for (int i = 0; i < totalStars - Math.Round(Model.Rate); i++)
                                {
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#E5E7EB" />
                                    </svg>

                                }
                            }
                        </div>
                        <span class="rating-info">
                            @if(Model.Rate != 0)
                            {
                                <span class="rating-count">@Math.Round(Model.Rate, 3)</span>
                            }
                            else
                            {
                                <span class="rating-count">Note rated yet, want to be first?:)</span>
                            }

                            
                            (@Model.reviews.Count reviews)
                        </span>
                    </div> 

                    <div class="book-meta-grid">
                        <div class="meta-item-large">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <div>
                                <div class="meta-label">Price</div>
                                <div class="meta-value">@Model.book.Book_price</div>
                            </div>
                        </div>

                        <div class="meta-item-large">
                            <svg viewBox="0 0 24 24">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                            </svg>
                            <div>
                                <div class="meta-label">Purchase number</div>
                                <div class="meta-value">@Model.PurchaseNum</div>
                            </div>
                        </div>

                        <div class="meta-item-large">
                            <svg viewBox="0 0 24 24">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            </svg>
                            <div>
                                <div class="meta-label">Type</div>
                                <div class="meta-value">@(Model.book.IsOnline? "Online" : "Physical")</div>
                            </div>
                        </div>

                        <div class="meta-item-large">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <div>
                                <div class="meta-label">Subject ID</div>
                                <div class="meta-value">@Model.Subject_name</div>
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons">
                        @if (Model.book.In_stock)
                        {
                            <button class="btn-large btn-add-to-cart" onclick="window.location.href='https://localhost:7121/Guest/viewSignInPage';">
                                <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                Add to Cart
                            </button>
                        }
                        else
                        {
                            <button class="btn-large btn-add-to-cart error" disabled onclick="window.location.href='https://localhost:7121/Guest/viewSignInPage';">
                                <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                Out of stock
                            </button>
                        }
                        @* <button class="btn-large btn-wishlist">
                            <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button> *@
                    </div>
                </div>
            </div>
        </div>

        <!-- Book Gallery -->
        <div class="book-gallery">
            <h2 class="section-title">Book Preview Gallery</h2>
            <div class="gallery-grid">
                <div class="gallery-item">
                    <img src="@Url.Action("GetBookImage", "Guest", new { bookID = Model.book.BookID })"
                         alt="Preview page 2"
                         class="gallery-image" />
                </div>
                <div class="gallery-item">
                    <img src="@Url.Action("GetBookImage", "Guest", new { bookID = Model.book.BookID })"
                         alt="Preview page 2"
                         class="gallery-image" />
                </div>
                <div class="gallery-item">
                    <img src="@Url.Action("GetBookImage", "Guest", new { bookID = Model.book.BookID })"
                         alt="Preview page 2"
                         class="gallery-image" />
                </div>
                <div class="gallery-item">
                    <img src="@Url.Action("GetBookImage", "Guest", new { bookID = Model.book.BookID })"
                         alt="Preview page 2"
                         class="gallery-image" />
                </div>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="reviews-section">
            <div class="reviews-header">
                <h2 class="section-title">Customer Reviews</h2>
                <button class="write-review-btn" onclick="window.location.href='https://localhost:7121/Guest/viewSignInPage';">Write a Review</button>
            </div>
            @if (Model.reviews != null && Model.reviews.Any())
            {
                @foreach (ViewReview review in Model.reviews)
                {
                    <div class="review-item">
                        <div class="review-header-section">
                            <div class="reviewer-details">
                                <div class="user-profile" onclick="">

                                    <div class="user-avatar">
                                        @* <img src="path-to-profile-image.jpg" alt="User" onerror="this.style.display='none'">
                            <img src="~/images/usersimages/ofek.png" /> *@

                                        @* @if (true)
                                        {
                                            Random random = new Random();
                                            int number2 = random.Next(1, 120); //ADD THE BLACK PEOPLE.
                                            int number = random.Next(1, 10);
                                            if (number == 6)
                                            {
                                                <img src="~/images/usersimages/ilgcdgxjyzuozcdwd70gnc9tah0c_genwj3dgvxocds9kmimgudvaxlutq-9igopu0ubwfy4s900-c-k-c0x00ffffff-no-rj.png" alt="User" onerror="this.style.display='none'">
                                                @* <img id="profileImage" src="~/images/usersimages/ilgcdgxjyzuozcdwd70gnc9tah0c_genwj3dgvxocds9kmimgudvaxlutq-9igopu0ubwfy4s900-c-k-c0x00ffffff-no-rj.png" alt="Profile" class="profile-image"> 

                                            }
                                            else
                                            {
                                                <img src="~/images/usersimages/ofek.png" alt="User" onerror="this.style.display='none'">

                                            }
                                        } *@
                                        @if (review.ImagePath == "None" || review.ImagePath == null)
                                        {
                                            if (review.UserName.Contains(" "))
                                            {
                                                string[] parts = review.UserName.Split(" ");
                                                <span class="avatar-text">

                                                    @parts[0][0]@parts[1][0]

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="avatar-text">

                                                    @review.UserName[0]@review.UserName[1]
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <img src="@Url.Action("GetProfileImage", "Registered", new { registeredID = review.RegisteredID })" alt="User" onerror="this.style.display='none'">


                                        }

                                        </div>
                                    </div>
                                <div class="reviewer-info-small">
                                    <div class="reviewer-name-small">@review.UserName</div>
                                    @* <div class="review-date-small">January 20, 2026</div> *@
                                </div>
                            </div>
                            <div class="review-rating">
                                @{
                                    totalStars = 5;
                                    starsAmount = Convert.ToInt16(review.Rate);
                                    for (int i = 0; i < starsAmount; i++)
                                    {
                                        <svg viewBox="0 0 24 24" width="24" height="24">
                                            <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                                  fill="#FACC15" />
                                        </svg>


                                    }
                                    if (review.Rate - starsAmount > 0)
                                    {
                                        <svg viewBox="0 0 24 24" width="24" height="24">
                                            <defs>
                                                <!-- חצי שמאלי של הכוכב -->
                                                <clipPath id="star-half-left">
                                                    <rect x="0" y="0" width="12" height="24" />
                                                </clipPath>
                                            </defs>

                                            <!-- רקע אפור (כוכב ריק) -->
                                            <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                                  fill="#E5E7EB" />

                                            <!-- חצי צהוב מעל -->
                                            <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                                  fill="#FACC15"
                                                  clip-path="url(#star-half-left)" />
                                        </svg>

                                    }
                                    for (int i = 0; i < totalStars - starsAmount; i++)
                                    {
                                        <svg viewBox="0 0 24 24" width="24" height="24">
                                            <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                                  fill="#E5E7EB" />
                                        </svg>

                                    }
                                }

                            </div>
                        </div>
                        <div class="review-text-content">
                            @review.Comment
                        </div>
                        <div class="review-actions">
                            <span style="color: #718096; font-size: 14px; margin-right: 8px;">Was this helpful?</span>
                            <button class="vote-btn" onclick="">
                                <svg viewBox="0 0 24 24">
                                    <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                                </svg>
                                <span>142</span>
                            </button>
                        </div>
                    </div>
                }
            }
            <!-- Review 1 -->
            @* <div class="review-item">
                <div class="review-header-section">
                    <div class="reviewer-details">
                        <div class="reviewer-avatar-small">SJ</div>
                        <div class="reviewer-info-small">
                            <div class="reviewer-name-small">Sarah Johnson</div>
                            <div class="review-date-small">January 20, 2026</div>
                        </div>
                    </div>
                    <div class="review-rating">
                        <span class="star-review">★</span>
                        <span class="star-review">★</span>
                        <span class="star-review">★</span>
                        <span class="star-review">★</span>
                        <span class="star-review">★</span>
                    </div>
                </div>
                <div class="review-text-content">
                    A timeless masterpiece that everyone should read! Harper Lee's portrayal of racial injustice and moral growth in the American South is both heartbreaking and inspiring. The characters, especially Atticus Finch and Scout, are beautifully developed and remain with you long after finishing the book. This novel is essential reading for understanding empathy, courage, and standing up for what's right.
                </div>
                <div class="review-actions">
                    <span style="color: #718096; font-size: 14px; margin-right: 8px;">Was this helpful?</span>
                    <button class="vote-btn" onclick="toggleLike(this)">
                        <svg viewBox="0 0 24 24">
                            <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
                        </svg>
                        <span>142</span>
                    </button>
                </div>
            </div> *@
        </div>
        </div>
</div>
<script>
    const mainCover = document.getElementById('mainCover');
    const galleryImages = document.querySelectorAll('.gallery-image');

    galleryImages.forEach(img => {
        img.addEventListener('click', () => {
            const fullSrc = img.getAttribute('data-full') || img.src;
            // mainCover.src = fullSrc;

            // סימון thumbnail פעיל
            galleryImages.forEach(i => i.classList.remove('active'));
            img.classList.add('active');
        });
    });
</script>