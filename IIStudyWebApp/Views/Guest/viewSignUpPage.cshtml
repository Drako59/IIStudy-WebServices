
@{
    ViewData["Title"] = "viewSignUpPage";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
@using LLStudy_Models.Models

@model Registered

<link href="~/css/SignUp.css" rel="stylesheet" />
<main class="main-content">
    <form asp-action="SignUp" asp-controller="Guest" method="post">
    <div class="container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Join us to explore our book collection</p>
            </div>

            <div class="social-buttons">
                <button class="social-btn">Facebook</button>
                <button class="social-btn">Google</button>
            </div>

            <div class="divider">
                <span>or sign up with email</span>
            </div>

            <div class="form-group">
                <label class="form-label" for="username">Usernames</label>
                    <input asp-for="UserName" value="ofri" type="text" id="username" class="form-input" placeholder="Choose a username">
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                    <input asp-for="Password" type="password" value="ilovet" id="password" class="form-input" placeholder="Create a strong password">
            </div>

            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input asp-for="Email"  type="email" id="email" value = "noam@test" class="form-input" placeholder="your@email.com">
            </div>

            <div class="form-group">
                <label class="form-label" for="birth">Birth Date</label>
                 <input asp-for="Birth" type="date" value="3.12.2007" id="birth" class="form-input" placeholder="DD/MM/YYYY">
            </div>

            <div class="checkbox-wrapper">
                <input type="checkbox" id="terms" required>
                <label class="checkbox-label" for="terms">
                    I agree to the <a href="#terms">Terms of Service</a> and <a href="#privacy">Privacy Policy</a>
                </label>
            </div>

            <button class="submit-btn">Create Account</button>

            <div class="auth-footer">
                    <p>Already have an account? <a href="@Url.Action("viewSignInPage", "Guest")">Sign in</a></p>
            </div>
        </div>
    </div>
    </form>
</main>

