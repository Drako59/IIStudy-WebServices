
@{
    ViewData["Title"] = "viewSignUpPage";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
@using LLStudy_Models.ViewModels;

@model SignUpResultModel;

<link href="~/css/SignUp.css" rel="stylesheet" />
<main class="main-content">
    <form asp-action="SignUp" asp-controller="Guest" method="post">
    <div class="container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Join us to explore our book collection</p>
            </div>

            @* <div class="social-buttons">
                <button class="social-btn">Facebook</button>
                <button class="social-btn">Google</button>
            </div> *@

            @* <div class="divider">
                <span>or sign up with email</span>
            </div> *@

            <div class="form-group">
                @if(Model?.UserNameAlreadyInUse ?? false)
                {
                    <span class="field-error">This username is already registered</span>
                }
                    @if (ViewBag.WasSubmitted == true)
                    {
                        <span asp-validation-for="UserName" class="field-error"></span>
                    }
                    <label class="form-label" for="username">Usernames</label>
                    <input asp-for="UserName"  type="text" id="username" class="form-input" placeholder="Choose a username">
            </div>

            <div class="form-group">
                    @if (ViewBag.WasSubmitted == true)
                    {
                        <span asp-validation-for="Password" class="field-error"></span>
                    }
                    <label class="form-label" for="password">Password</label>
                    <input asp-for="Password" type="password"  id="password" class="form-input" placeholder="Create a strong password">
            </div>

            <div class="form-group">
                @if (Model?.EmailAlreadyInUse ?? false)
                {
                    <span class="field-error">This email is already registered</span>
                }
                    @if (ViewBag.WasSubmitted == true)
                    {
                        <span asp-validation-for="Email" class="field-error"></span>
                    }
                    <label class="form-label" for="email">Email</label>
                    <input asp-for="Email" type="email" id="email"  class="form-input" placeholder="your@email.com">
            </div>

            <div class="form-group">
                    @if (ViewBag.WasSubmitted == true)
                    {
                        <span asp-validation-for="Phone" class="field-error"></span>
                    }
                    <label class="form-label" for="phone">Phone Number</label>
                <input asp-for="Phone" type="text" id="phone"  class="form-input" placeholder="05XXXXXXXX">
            </div>

            <div class="form-group">
                    @if (ViewBag.WasSubmitted == true)
                    {
                        <span asp-validation-for="Birth" class="field-error"></span>
                    }
                    <label class="form-label" for="birth">Birth Date</label>
                 <input asp-for="Birth" type="date"  id="birth" class="form-input" placeholder="DD/MM/YYYY">
            </div>

            <div class="checkbox-wrapper">
                <input type="checkbox" id="terms" required>
                <label class="checkbox-label" for="terms">
                    I agree to the <a href="#terms">Terms of Service</a> and <a href="#privacy">Privacy Policy</a>
                </label>
            </div>

            <button class="submit-btn">Create Account</button>

            <div class="auth-footer">
                    <p>Already have an account? <a href="@Url.Action("viewSignInPage", "Guest")">Sign in</a></p>
            </div>
        </div>
    </div>
    </form>
</main>

