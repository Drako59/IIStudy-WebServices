
@{
    ViewData["Title"] = "ViewShoppingCart";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";
}

@using LLStudy_Models.ViewModels
@using LLStudy_Models.Models
@model ViewShoppingCartModel


<link href="../Css/shoppingcart.css" rel="stylesheet" />


<!-- Shopping Cart Page -->
<div class="cart-page">
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Shopping Cart</h1>
            <p class="page-subtitle">Review your items and proceed to checkout</p>
        </div>

        <div class="cart-layout">
            <!-- Cart Items -->
            <div class="cart-items-section">
                <!-- Cart Item 1 -->
                @if (Model.CartBooks != null && Model.CartBooks.Any())
                {
                    foreach (CartBookViewModel cartBook in Model.CartBooks)
                    {
                        bool InStock = Model.OutOfStockBooks.Contains(cartBook.Book.BookID);
                        <div class="cart-item @(InStock ? "out-of-stock-item" : "")">
                            <div class="item-image">
                                <img src="@Url.Action("GetBookImage", "Guest", new { bookID = cartBook.Book.BookID })"
                                     onerror="this.src='/images/books/placeholder.png'"
                                     alt="@cartBook.Book.Book_name"
                                     class="item-image-img" />

                            </div>
                            <div class="item-details">
                                <h3 class="item-title">@cartBook.Book.Book_name</h3>
                                <p class="item-author">@cartBook.Book.Author_name</p>
                                <p class="item-meta">@(cartBook.Book.IsOnline? "Online" : "Physical") format</p>
                                <div class="stock-count-info">
                                    <span class="stock-count-label">Available stock:</span>
                                    <span class="stock-count-value">@cartBook.Book.StockCount</span>
                                </div>
                                <div class="stock-warning @(InStock ? "" : "stock-warning-hidden" )">
                                    <div class="stock-warning-icon">!</div>
                                    <div class="stock-warning-content">
                                        <strong>Out of stock</strong>
                                        <span>This book is currently out of this amount stock.</span>
                                    </div>
                                </div>
                                
                                <div class="item-actions">
                                    <div class="quantity-control">
                                        <button class="qty-btn" onclick="removeAndUpdate(this,@cartBook.Book.BookID)">−</button>
                                        <span class="qty-value">@cartBook.CountBooks</span>
                                        <button class="qty-btn" onclick="addAndUpdate(this,@cartBook.Book.BookID)">+</button>
                                    </div>
                                    <button class="remove-btn" onclick="removeItem(this,@cartBook.Book.BookID)" id="book-@cartBook.Book.BookID">Remove</button> <!--window.location.href=`https://localhost:7121/Registered/RemoveFromCart?BookID=${@cartBook.Book.BookID};-->
                                </div>
                            </div>
                            <div class="item-price-section">
                                <div class="item-price">$@cartBook.Book.Book_price</div>
                                <div class="item-price-label">Price</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-cart">
                        <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        <h3>Your cart is empty</h3>
                        <p>Looks like you haven't added any books yet</p>
                        <button class="checkout-btn" onclick="continueShopping()">Browse Books</button>
                    </div>
                }
            </div>
                

            <!-- Order Summary -->
            <div class="order-summary">
                <h2 class="summary-title">Order Summary</h2>
                    
                <div class="summary-row">
                    <span class="summary-label">Subtotal (4 items)</span>
                    <span class="summary-value sum-value">$163.00</span>
                </div>
                    
                <div class="summary-row">
                    <span class="summary-label">Shipping</span>
                    <span class="summary-value">$0.00</span>
                </div>
                    
                <div class="summary-row">
                    <span class="summary-label">Tax (10%)</span>
                    <span class="summary-value tax-value">$16.30</span>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-total">
                    <span class="total-label">Total</span>
                    <span class="total-value">$184.30</span>
                </div>

                <button class="checkout-btn" onclick="checkout()">Proceed to Checkout</button>
                <button class="continue-shopping" onclick="continueShopping()">Continue Shopping</button>

                <div class="promo-section">
                    <div class="summary-label">Have a promo code?</div>
                    <div class="promo-input">
                        <input type="text" placeholder="Enter code">
                        <button class="apply-btn">Apply</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/ShoppingCart.js"></script>



