
@{
    ViewData["Title"] = "ViewShoppingCart";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";
}

@using LLStudy_Models.ViewModels
@using LLStudy_Models.Models
@model ViewShoppingCartModel


<link href="../Css/shoppingcart.css" rel="stylesheet" />


<!-- Shopping Cart Page -->
<div class="cart-page">
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Shopping Cart</h1>
            <p class="page-subtitle">Review your items and proceed to checkout</p>
        </div>

        <div class="cart-layout">
            <!-- Cart Items -->
            <div class="cart-items-section">
                <!-- Cart Item 1 -->
                @if (Model.Books != null && Model.Books.Any())
                {
                    foreach (Book book in Model.Books)
                    {
                        <div class="cart-item">
                            <div class="item-image">
                                <img src="../Images/HomePage_Guest_Images/0b9b4d7903c0f8b8cdd4d451e7ae3d19.jpg"
                                     onerror="this.src='/images/books/placeholder.png'"
                                     alt="@book.Book_name"
                                     class="item-image-img" />

                            </div>
                            <div class="item-details">
                                <h3 class="item-title">@book.Book_name</h3>
                                <p class="item-author">by Harper Lee</p>
                                <p class="item-meta">PDF Format • Fiction</p>
                                <div class="item-actions">
                                    <div class="quantity-control">
                                        <button class="qty-btn" onclick="updateQty(this, -1)">−</button>
                                        <span class="qty-value">1</span>
                                        <button class="qty-btn" onclick="updateQty(this, 1)">+</button>
                                    </div>
                                    <button class="remove-btn" onclick="removeItem(this)">Remove</button>
                                </div>
                            </div>
                            <div class="item-price-section">
                                <div class="item-price">$@book.Book_price</div>
                                <div class="item-price-label">Price</div>
                            </div>
                        </div>
                    }
                }
            </div>
                

            <!-- Order Summary -->
            <div class="order-summary">
                <h2 class="summary-title">Order Summary</h2>
                    
                <div class="summary-row">
                    <span class="summary-label">Subtotal (4 items)</span>
                    <span class="summary-value">$163.00</span>
                </div>
                    
                <div class="summary-row">
                    <span class="summary-label">Shipping</span>
                    <span class="summary-value">$5.00</span>
                </div>
                    
                <div class="summary-row">
                    <span class="summary-label">Tax (10%)</span>
                    <span class="summary-value">$16.30</span>
                </div>

                <div class="summary-divider"></div>

                <div class="summary-total">
                    <span class="total-label">Total</span>
                    <span class="total-value">$184.30</span>
                </div>

                <button class="checkout-btn" onclick="checkout()">Proceed to Checkout</button>
                <button class="continue-shopping" onclick="continueShopping()">Continue Shopping</button>

                <div class="promo-section">
                    <div class="summary-label">Have a promo code?</div>
                    <div class="promo-input">
                        <input type="text" placeholder="Enter code">
                        <button class="apply-btn">Apply</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function updateQty(btn, change) {
        const qtyElement = btn.parentElement.querySelector('.qty-value');
        let currentQty = parseInt(qtyElement.textContent);
        let newQty = currentQty + change;
            
        if (newQty >= 1) {
            qtyElement.textContent = newQty;
            updateTotal();
        }
    }

    function removeItem(btn) {
        const cartItem = btn.closest('.cart-item');
        cartItem.style.opacity = '0';
        cartItem.style.transform = 'translateX(-20px)';
        setTimeout(() => {
            cartItem.remove();
            updateTotal();
            checkEmptyCart();
        }, 300);
    }

    function updateTotal() {
        // In a real app, this would recalculate based on actual prices
        console.log('Updating total...');
    }

    function checkEmptyCart() {
        const cartItems = document.querySelectorAll('.cart-item');
        if (cartItems.length === 0) {
            const cartSection = document.querySelector('.cart-items-section');
            cartSection.innerHTML = `
                <div class="empty-cart">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <h3>Your cart is empty</h3>
                    <p>Looks like you haven't added any books yet</p>
                    <button class="checkout-btn" onclick="continueShopping()">Browse Books</button>
                </div>
            `;
        }
    }

    function checkout() {
        alert('Proceeding to checkout...');
    }

    function continueShopping() {
        alert('Redirecting to book catalog...');
    }
</script>


