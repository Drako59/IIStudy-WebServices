                            </svg>
                            <div>
                                <div class="meta-label">Type</div>
                                <div class="meta-value">@(Model.BookViewModel.book.IsOnline ? "Online" : "Physical")</div>
                            </div>
                        </div>

                        <div class="meta-item-large">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <div>
                                <div class="meta-label">Subject ID</div>
                                <div class="meta-value">@Model.BookViewModel.Subject_name</div>
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons">
                        @if (Model.BookViewModel.book.In_stock)
                        {
                            bool isPurchased = Model.IsOwned;
                            bool isInCart = Model.IsInShoppingCart;
                            <button class="btn-large btn-add-to-cart @(isPurchased? "purchased": isInCart ? "in-cart" : "")" id="book-@Model.BookViewModel.book.BookID" onclick="@((isInCart || isPurchased) ? " " : $"AddToCart({Model.BookViewModel.book.BookID})")">
                                <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                @if (isPurchased)
                                {
                                    <a href="@Url.Action("GetBookFile", "Registered", new { bookID = Model.BookViewModel.book.BookID })" target="_blank">Read Book</a>
                                }

                                else @(isInCart ? "In Cart" : "Add to Cart")
                                

                            </button>
                        }
                        else
                        {
                            <button class="btn-large btn-add-to-cart error" disabled id="book-@Model.BookViewModel.book.BookID" onclick="AddToCart(@Model.BookViewModel.book.BookID)">
                                <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                Out of stock
                            </button>
                        }
                        @* <button class="btn-large btn-wishlist">
                            <svg viewBox="0 0 24 24" style="width: 20px; height: 20px; stroke: currentColor; fill: none;">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </button> *@
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.BookViewModel.book.BookDetails)
