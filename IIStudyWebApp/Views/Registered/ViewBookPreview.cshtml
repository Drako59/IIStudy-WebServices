
@{
    ViewData["Title"] = "ViewBookPreview";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";
}

@using LLStudy_Models.Models
@using LLStudy_Models.ViewModels
@model ViewRegisteredBookPreviewModel

<link href="~/css/bookpreview.css" rel="stylesheet" />
<div class="book-details-page">
    <div class="container">
        <div class="breadcrumb">
            <a href="#">Home</a> / <a href="#">Fiction</a> / <strong>@Model.BookViewModel.book.Book_name</strong>
        </div>

        <!-- Main Book Information -->
        <div class="book-main-section">
            <div class="book-header">
                <div class="book-cover-main">
                    <img class="book-cover-image" src="@Url.Action("GetBookImage", "Guest", new { bookID = Model.BookViewModel.book.BookID })" /> <!-- CHANE TO A REAL IMAGE-->
                    @* <svg viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M7 8h10M7 12h8M7 16h6" />
                    </svg> *@
                </div>

                <div class="book-info-main">
                    @if (Model.BookViewModel.book.In_stock)
                    {
                        <span class="stock-badge in-stock">
                            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none;">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            In Stock
                        </span>
                    }
                    else
                    {
                        <span class="stock-badge out-stock">
                            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none;">
                                <path d="M6 6L18 18M18 6L6 18"></path>
                            </svg>
                            Out Stock
                        </span>
                    }

                    <h1 class="book-title-main">@Model.BookViewModel.book.Book_name</h1>
                    <p class="book-author-main">@Model.BookViewModel.book.Author_name</p>

                    <div class="rating-section">
                        <div class="stars-large">
                            @{
                                int totalStars = 5;
                                double starsAmount = Math.Floor(Model.BookViewModel.Rate);

                                for (int i = 0; i < starsAmount; i++)
                                {
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#FACC15" />
                                    </svg>


                                }
                                if (Model.BookViewModel.Rate - starsAmount > 0)
                                {
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <defs>
                                            <!-- חצי שמאלי של הכוכב -->
                                            <clipPath id="star-half-left">
                                                <rect x="0" y="0" width="12" height="24" />
                                            </clipPath>
                                        </defs>

                                        <!-- רקע אפור (כוכב ריק) -->
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#E5E7EB" />

                                        <!-- חצי צהוב מעל -->
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#FACC15"
                                              clip-path="url(#star-half-left)" />
                                    </svg>

                                }
                                for (int i = 0; i < totalStars - (!double.IsInteger(Model.BookViewModel.Rate) ? Math.Floor(Model.BookViewModel.Rate) + 1 : Math.Floor(Model.BookViewModel.Rate)) ; i++)
                                {
                                    <svg viewBox="0 0 24 24" width="24" height="24">
                                        <path d="M12 .587l3.668 7.431L23.327 9.75l-5.664 5.51L18.997 24 12 19.897 5.003 24l1.334-8.74L.673 9.75l7.659-1.732z"
                                              fill="#E5E7EB" />
                                    </svg>

                                }
                            }
                        </div>
                        <span class="rating-info">
                            @if (Model.BookViewModel.Rate != 0)
                            {
                                <span class="rating-count">@Math.Round(Model.BookViewModel.Rate, 3)</span>
                            }
                            else
                            {
                                <span class="rating-count">Note rated yet, want to be first?:)</span>
                            }


                            (@Model.BookViewModel.reviews.Count reviews)
                        </span>
                    </div>

                    <div class="book-meta-grid">
                        <div class="meta-item-large">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <div>
                                <div class="meta-label">Price</div>
                                <div class="meta-value">₪@Model.BookViewModel.book.Book_price</div>
                            </div>
                        </div>

                        <div class="meta-item-large">
