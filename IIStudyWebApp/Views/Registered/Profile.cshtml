@using LLStudy_Models.Models
@using LLStudy_Models.ViewModels;

@model Registered
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";
}

@{
    Registered regSession = ViewData["Registered"] as Registered;
}



@if (regSession == null)
{
    regSession = new Registered()
    {
        UserName = "None",
        Email = "None",
        Birth = "None",
        
    };
}
@{
    UpdateProfileResult error = ViewBag.ErrorStatus;
    if (error == null)
        error = new UpdateProfileResult();
}

@{
    bool? changedPassword = null;

    if (ViewBag.PasswordChanged != null)
    {
        bool parsedValue;
        if (bool.TryParse(ViewBag.PasswordChanged.ToString(), out parsedValue))
        {
            changedPassword = parsedValue;
        }
    }
}

<link href="../Css/profile.css" rel="stylesheet" />
<div class="content-wrapper">
    <div class="profile-container">
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-image-container">
                @* @if (true)
                {
                    Random random = new Random();
                    int number = random.Next(1, 10);
                    if(number == 6)
                    {
                        <img id="profileImage" src="~/images/usersimages/ilgcdgxjyzuozcdwd70gnc9tah0c_genwj3dgvxocds9kmimgudvaxlutq-9igopu0ubwfy4s900-c-k-c0x00ffffff-no-rj.png" alt="Profile" class="profile-image">

                    }
                    else
                    {
                        <img id="profileImage" src="~/images/usersimages/ofek.png" alt="Profile" class="profile-image">

                    }
                } *@

                @if (Model.ImagePath.ToLower() == "none" || Model.ImagePath == null)
                {
                    if (Model.UserName.Contains(" "))
                    {
                        string[] parts = regSession.UserName.Split(" ");
                        <span class="profile-initials">
                            
                            @parts[0][0]@parts[1][0]

                        </span>
                    }
                    else
                    {
                        <span class="profile-initials">

                            @regSession.UserName[0]@regSession.UserName[1]
                        </span>
                    }
                }
                else
                {
                    <img id="profileImage" src="@Url.Action("GetProfileImage", "Registered", new { registeredID = regSession.RegisteredID })" alt="Profile" class="profile-image">
                }
                <button class="change-photo-btn" onclick="document.getElementById('imageInput').click()">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </button>
                <form asp-action="ChangeProfileImage" asp-controller="Registered" method="post" enctype="multipart/form-data">
                    <input type="file" name="image" id="imageInput" accept="image/*" onchange="this.form.submit();">
                </form>
            </div>
            <h1 class="profile-name" id="userName">@regSession.UserName</h1>
            <div class="profile-actions">
                <button type="button" class="profile-action-btn primary" onclick="openUpdatePopup()">
                    Edit Profile
                </button>

                <button type="button" class="profile-action-btn secondary" onclick="openChangePasswordPopup()">
                    Change Password
                </button>
            </div>
        </div>

        <!-- Profile Body -->
        <div class="profile-body">
            @if (changedPassword == true)
            {
                <div class="password-success-message">
                    Password changed successfully.
                </div>
            }
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Full Name</div>
                        <div class="info-value" id="displayName">@regSession.UserName</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>

                    @{
                        int age;
                        DateTime now = DateTime.Now;
                        if(!DateTime.TryParseExact(
                                                    regSession.Birth,
                                                    "yyyy-MM-dd",
                                                    System.Globalization.CultureInfo.InvariantCulture,
                                                    System.Globalization.DateTimeStyles.None,
                                                    out DateTime birthTime
                                                    ))
                        {
                            age = -1;
                        }
                        else
                        {
                            age = now.Year - birthTime.Year;
                            if (now.Month < birthTime.Month || (now.Month == birthTime.Month && now.Day < birthTime.Day))
                            {
                                age--;
                            }
                        }
                    }

                    <div class="info-content">
                        <div class="info-label">Age</div>
                        <div class="info-value" id="displayAge">@age</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Birthday</div>
                        <div class="info-value" id="displayBirthday">@regSession.Birth</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div class="info-content">
                        <div class="info-label"></div>
                        <div class="info-value" id="displayEmail">@regSession.Email</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Phone</div>
                        <div class="info-value" id="displayPhone">@regSession.Phone</div>
                    </div>
                </div>
            </div>

            <!-- Books Section -->
            <div class="books-section">
                <svg style="width: 60px; height: 60px; margin: 0 auto; display: block;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <div class="books-count" id="booksCount">@(ViewBag?.NumOfBooksInLibary ?? "?")</div>
                <div class="books-label">Books in Your Collection</div>
                <a href="@Url.Action("ViewMyLibary", "Registered")" class="view-books-btn">View My Books</a>
            </div>
        </div>
    </div>
</div>

<div id="updateProfilePopup" class="popup-overlay">
    <div class="popup-box">
        <button type="button" class="popup-close" onclick="closeUpdatePopup()">×</button>

        <div class="popup-header">
            <h2>Update Profile</h2>
            <p>You can update your personal details here.</p>
        </div>

        <form asp-action="UpdateProfile" asp-controller="Registered" method="post" class="update-profile-form">

            <div class="form-row">
                @if (error.UserNameIsTaken)
                {
                    <span class="field-error">User name is already taken</span>
                }
                <span asp-validation-for="UserName" class="field-error"></span>
                <label>User Name</label>
                <input asp-for="UserName" type="text"  required />
            </div>

            <div class="form-row">
                @if (error.EmailIsTaken)
                {
                    <span class="field-error">Email is already taken</span>
                }
                <span asp-validation-for="Email" class="field-error"></span>
                <label>Email</label>
                <input asp-for="Email" type="email"  required />
            </div>

            <div class="form-row">
                <span asp-validation-for="Birth" class="field-error"></span>
                <label>Birthday</label>
                <input asp-for="Birth" type="date"  />
            </div>

            <div class="form-row">
                <span asp-validation-for="Phone" class="field-error"></span>
                <label>Phone</label>
                <input asp-for="Phone" type="text"  placeholder="Enter your phone number" />
            </div>

            <div class="password-warning">
                Password cannot be changed here for security reasons.
                Use the separate password change page.
            </div>

            <div class="popup-buttons">
                <button type="button" class="cancel-btn" onclick="closeUpdatePopup()">Cancel</button>
                <button type="submit" class="save-btn">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<div id="changePasswordPopup" class="popup-overlay">
    <div class="popup-box">
        <button type="button" class="popup-close" onclick="closeChangePasswordPopup()">×</button>

        <div class="popup-header">
            <h2>Change Password</h2>
            <p>Enter your new password.</p>
        </div>

        <form asp-action="ChangePassword" asp-controller="Registered" method="post" class="update-profile-form">
            @Html.AntiForgeryToken()

            @if (changedPassword == false)
            {
                <div class="password-error-message">
                    Password was not changed. Please try again with atleast 8 characters.
                </div>
            }

            <div class="form-row">
                <label>New Password</label>
                <input name="newPassword" type="password" required placeholder="Enter new password" />
                <input name="RegisteredID" type="hidden" value="0" />
            </div>

            <div class="popup-buttons">
                <button type="button" class="cancel-btn" onclick="closeChangePasswordPopup()">Cancel</button>
                <button type="submit" class="save-btn">Change Password</button>
            </div>
        </form>
    </div>
</div>
    
<script src="~/js/profile.js"></script>
@if (!ViewData.ModelState.IsValid || (ViewBag.ErrorStatus != null && (ViewBag.ErrorStatus.UserNameIsTaken || ViewBag.ErrorStatus.EmailIsTaken)))
{
    <script>
        openUpdatePopup();
    </script>

}

@if (changedPassword == false)
{
    <script>
        openChangePasswordPopup();
    </script>
}