
@{
    ViewData["Title"] = "ViewExamsBySubjectAndYear";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";
}

@using LLStudy_Models.ViewModels
@model List<ExamDetailsWeb>

<link href="~/css/examsbyyearandsubject.css" rel="stylesheet" />

<div class="exams-page">
    <div class="container">
        <div class="page-header">
            <div class="breadcrumb">
                <a href="@Url.Action("ViewExamsPage", "Registered")">Home</a> / <a href="@Url.Action("ViewExamYearsPage", "Registered", new { subjectID = Model?[0].SubjectID ?? "1" })">@(Model != null && Model.Any() ? Model[0].Subject_name : "Failed")</a> / <strong>@(Model != null && Model.Any() ? Model[0].Exam_Year.Substring(0, 4) : "Failed")</strong>
            </div>
            <h1 class="page-title">Exams @(Model != null && Model.Any() ? Model[0].Exam_Year.Substring(0, 4) : "Failed")</h1>
            <p class="page-subtitle">Browse and access exam materials</p>
        </div>

        <!-- Search Bar -->
        <div class="search-section">
            <div class="search-box">
                <svg viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input type="text" placeholder="Search exams by name or subject..." id="searchInput" oninput="searchExams()">
            </div>
        </div>

        <!-- Exams List -->
        <div class="exams-section">
            <div class="section-header">
                <h2 class="section-title">Available Exams</h2>
                <span class="results-count" id="resultsCount">@Model.Count() Exams@(Model.Count() > 1 ? "s" : "") found </span>
            </div>

            <div class="exams-list" id="examsList">
                <!-- Exams will be dynamically loaded here -->
                @if (Model.Count() == 0)
                {
                    <div class="no-results">
                        <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                        <h3>No exams found</h3>
                        <p>Try adjusting your search terms</p>
                    </div>
                }
                else
                {
                    foreach (ExamDetailsWeb exam in Model)
                    {
                        <div class="exam-row">
                            <div class="exam-info">
                                <div class="exam-name">@exam.Exam_Name</div>
                                <div class="exam-meta">
                                    <div class="exam-meta-item">
                                        <svg viewBox="0 0 24 24">
                                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                                        </svg>
                                        <strong>Subject:</strong> @exam.Subject_name
                                    </div>
                                    <div class="exam-meta-item">
                                        <svg viewBox="0 0 24 24">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <strong>Date:</strong> @exam.Exam_Year
                                    </div>
                                    <div class="exam-meta-item">
                                        <svg viewBox="0 0 24 24">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <polyline points="12 6 12 12 16 14"></polyline>
                                        </svg>
                                        <strong>Year:</strong> @exam.Exam_Year
                                    </div>
                                </div>
                            </div>
                            <div class="exam-actions">
                                @if (exam.HasFile)
                                {
                                    <a class="exam-btn btn-view" href="@Url.Action("ViewExamFile", "Guest", new { examID = exam.ExamID})" target="_blank">
                                        <svg viewBox="0 0 24 24">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        View Exam
                                    </a>
                                }
                                <a class="exam-btn btn-solutions" href="@Url.Action("ViewSolutionsByExam", "Registered", new {examID = exam.ExamID})">
                                    <svg viewBox="0 0 24 24">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    Solutions
                                </a>
                            </div>
                        </div>
                    }
                }

            </div>
        </div>
    </div>
</div>

<script>
    



    // Format date
    function formatDate(dateString) {
        const date = new Date(dateString);
        const options = { year: 'numeric', month: 'short', day: 'numeric' };
        return date.toLocaleDateString('en-US', options);
    }

    // Search exams
    function searchExams() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();

        const filteredExams = examsData.filter(exam => {
            return exam.examName.toLowerCase().includes(searchTerm) ||
                   exam.subjectName.toLowerCase().includes(searchTerm);
        });

    }

    // View exam
    function viewExam(examId) {
        alert(`Opening exam with ID: ${examId}`);
        // In production: window.location.href = `/exams/view/${examId}`;
    }

    // View solutions
    function viewSolutions(examId) {
        alert(`Opening solutions for exam ID: ${examId}`);
        // In production: window.location.href = `/exams/solutions/${examId}`;
    }

    // Initialize on page load
    // window.addEventListener('DOMContentLoaded', () => {
    //     fetchExamsFromDB();
    // });

