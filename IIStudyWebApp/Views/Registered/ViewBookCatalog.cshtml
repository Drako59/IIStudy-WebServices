            @if (Model != null && Model.Any())
            {
                @foreach (Book book in Model)
                {
                    string path = $"https://localhost:7121/Registered/ViewBookPreview?bookID={book.BookID}";
                    <div class="book-card">
                        <a href=@path class="book-cover"><img class="image_div" src="../Images/HomePage_Guest_Images/0b9b4d7903c0f8b8cdd4d451e7ae3d19.jpg"></a>
                        <div class="book-info">
                            <h3>@book.Book_name</h3>
                            <p class="book-author">@book.Author_name</p>
                            <p class="book-price">$@book.Book_price</p>
                            <button class="add-to-cart" onclick="AddToCart(@book.BookID)">Add to Cart</button>
                        </div>
                    </div>
                }
            }



        </div>






    </div>
</main>

<script>
    async function AddToCart(bookId) {
        try {
            const response = await fetch(
                `https://localhost:7121/Registered/AddToCart?bookId=${encodeURIComponent(bookId)}`,
                {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    }
                }
            );

            if (!response.ok) {
                alert("Didn't work");
                // showAddToCartError(bookId);
                return;
            }

            const data = await response.json(); // { success: true/false }
            alert(data.success);


            // if (data.success) {
