@using LLStudy_Models.Models
@model List<Book>

@{
    ViewData["Title"] = "ViewBookCatalog";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";

}


<link rel="stylesheet" href="../Css/bookCatalog_claude.css">

<section class="search-section">
    <div class="container">
        <div class="search-container">
            <input type="text" class="search-input" placeholder="Search for books, authors, categories...">
            <div class="search-icon">🔍</div>
        </div>
    </div>
</section>

<!-- Main Content -->
<main class="main-content">

    <div class="container">
        <div class="books-grid">
            <!-- Book Cards -->
            @* @if (Model != null && Model.Any())
            {
                @foreach (Book book in Model)
                {
                    <div class="book-card">
                            <span class="category-tag">Fiction</span>
                        <div class="book-image">
                            <img class="image_div" src="../Images/HomePage_Guest_Images/0b9b4d7903c0f8b8cdd4d451e7ae3d19.jpg">
                        </div>
                        <h3 class="book-title">@book.Book_name</h3>
                        <div class="book-actions">
                            <button class="action-btn btn-add-cart">Add to Cart</button>
                            <button class="action-btn btn-preview">Preview</button>
                        </div>
                    </div>
                }
            } *@





            @if (Model != null && Model.Any())
            {
                @foreach (Book book in Model)
                {
                    string path = $"https://localhost:7121/Registered/ViewBookPreview?bookID={book.BookID}";
                    <div class="book-card">
                        <a href=@path class="book-cover"><img class="image_div" src="../Images/HomePage_Guest_Images/0b9b4d7903c0f8b8cdd4d451e7ae3d19.jpg"></a>
                        <div class="book-info">
                            <h3>@book.Book_name</h3>
                            <p class="book-author">@book.Author_name</p>
                            <p class="book-price">$@book.Book_price</p>
                            <button class="add-to-cart" onclick="window.location.href='https://localhost:7121/Guest/viewSignInPage';">Add to Cart</button>
                        </div>
                    </div>
                }
            }



        </div>






    </div>
</main>