
@{
    ViewData["Title"] = "ViewUserOrders";
    Layout = "~/Views/Shared/RegisteredMasterPage.cshtml";
}
@using LLStudy_Models.ViewModels
@using LLStudy_Models.Models

@model ViewOrdersModel
<link href="../Css/orders.css" rel="stylesheet" />
<div class="orders-page">
    <div class="container">
        <div class="page-header">
            <div class="page-title-section">
                <h1>My Orders</h1>
                <p class="page-subtitle">Track and manage your book orders</p>
            </div>

            <div class="filter-tabs">
                <button class="filter-tab active" onclick="filterOrders('all')">All Orders</button>
                <button class="filter-tab" onclick="filterOrders('pending')">Pending</button>
                <button class="filter-tab" onclick="filterOrders('processing')">Processing</button>
                <button class="filter-tab" onclick="filterOrders('shipped')">Shipped</button>
                <button class="filter-tab" onclick="filterOrders('delivered')">Delivered</button>
                <button class="filter-tab" onclick="filterOrders('canceled')">Canceled</button>
                <button class="filter-tab" onclick="filterOrders('refund')">Refund</button>
            </div>
        </div>

        @{
            string DeliveryIcon(OrderStatus orderStatus)
            {
                return orderStatus switch
                {
                    OrderStatus.Pending =>"<circle cx='12' cy='12' r='10'></circle><polyline points='12 6 12 12 16 14'></polyline>",
                    OrderStatus.Processing => "<circle cx='12' cy='12' r='10'></circle><polyline points='12 6 12 12 16 14'></polyline>",
                    OrderStatus.Shipped => "<rect x='1' y='3' width='15' height='13'></rect><polygon points='16 8 20 8 23 11 23 16 16 16 16 8'></polygon><circle cx='5.5' cy='18.5' r='2.5'></circle><circle cx='18.5' cy='18.5' r='2.5'></circle>",
                    OrderStatus.Delivered => "<polyline points='20 6 9 17 4 12'></polyline>",
                    OrderStatus.Canceled => "<circle cx='12' cy='12' r='10'></circle><line x1='15' y1='9' x2='9' y2='15'></line><line x1='9' y1='9' x2='15' y2='15'></line>",
                    OrderStatus.Refund => "<polyline points='1 4 1 10 7 10'></polyline><path d='M3.51 15a9 9 0 1 0 .49-3.31'></path>",
                    _ => "<circle cx='12' cy='12' r='10'></circle><polyline points='12 6 12 12 16 14'></polyline>"
                };
            }
        }

        <div class="orders-content">
            <!-- Order 1 - Delivered -->
            @foreach (ViewOrderDetailsModel order in Model.Orders)
            {
                string delivered = (OrderStatus)order.Order.DeliveryStatus switch
                {
                    OrderStatus.Pending => "pending",
                    OrderStatus.Processing => "processing",
                    OrderStatus.Shipped => "shipped",
                    OrderStatus.Delivered => "delivered",
                    OrderStatus.Canceled => "canceled",
                    OrderStatus.Refund => "refund",
                    _ => "pending"
                };



                <div class="order-card" data-status="@delivered">
                    <div class="order-header">
                        <div class="order-info-left">
                            <div class="order-number">Order #@order.Order.OrderID</div>
                            <div class="order-date">Placed on @order.Order.Date</div>
                        </div>
                        <div class="order-status @delivered">
                            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none;">
                                @Html.Raw(DeliveryIcon((OrderStatus)order.Order.DeliveryStatus))
                            </svg>
                            @delivered
                        </div>
                    </div>

                    <div class="order-items">
                        @{
                            int counter = 0;
                            int totalBooks = order.Books?.Count ?? 0;
                            int remainingBooks = totalBooks > 3 ? totalBooks - 3 : 0;
                         }
                        @foreach (OrderBook book in order.Books)
                        {
                            counter++;
                            <div class="order-item">
                                    <div class="order-item-image">
                                        <img src="@Url.Action("GetBookImage", "Guest", new { bookID = book.BookID })"
                                                 alt="To Kill a Mockingbird cover">
                                    </div>
                                    <div class="order-item-details">
                                        <h4>@book.Book_name</h4>
                                        <p>by @book.Author_name</p>
                                        <p>@(book.IsOnline? "Online" : "Physical") Format</p>
                                    </div>
                                    <div class="order-item-price">
                                        <div class="item-price-main">@book.Book_price</div>
                                        <div class="item-quantity">Qty: @book.Amount</div>
                                    </div>
                            </div>
                            if (counter >= 3) break;
                        }

                        @{
                            if(remainingBooks > 0)
                            {
                                <div class="more-items-label">
                                    +@remainingBooks more book@(remainingBooks > 1 ? "s" : "")
                                </div>
                            }
                        }

                      
                    </div>

                    <div class="order-footer">
                        <div class="order-total">
                            <div class="order-total-label">Order Total</div>
                            <div class="order-total-value">$@order.Order.Total_price</div>
                        </div>
                        <div class="order-actions">
                            <button class="order-btn btn-primary" onclick="viewOrder(@order.Order.OrderID)">
                                <svg viewBox="0 0 24 24">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                View Details
                            </button>
                            @* <button class="order-btn btn-secondary" onclick="downloadInvoice(1)">
                                <svg viewBox="0 0 24 24">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Invoice
                            </button> *@
                        </div>
                    </div>
                </div>
            }

